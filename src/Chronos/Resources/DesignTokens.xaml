<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Chronos.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Tokens couleur VERROUILLÉS (maquette / 05-CONTEXT) — source unique de vérité (CAD-01).
         Dictionnaire autonome pour être chargeable à la fois par App.xaml (MergedDictionaries)
         et par les smoke tests (pack URI), sans dépendre d'une Application démarrée. -->
    <SolidColorBrush x:Key="FondCadran"          Color="#E616151B"/>  <!-- fond cadran semi-transparent -->
    <SolidColorBrush x:Key="Rim"                 Color="#2C2B34"/>    <!-- liseré extérieur -->
    <SolidColorBrush x:Key="TickMineur"          Color="#34333D"/>    <!-- graduations mineures -->
    <SolidColorBrush x:Key="TickMajeur"          Color="#46454F"/>    <!-- graduations majeures -->
    <SolidColorBrush x:Key="TickVisible"         Color="#C9C8D2"/>    <!-- graduations bien visibles (marques horaires 5 h + resets 24 h) -->
    <SolidColorBrush x:Key="TickReset"           Color="#F4F2EC"/>    <!-- marques de RESET 5 h = blanc chaud PRIMAIRE (même neutre que le texte principal) : hiérarchie
                                                                          cohérente sur l'échelle neutre (resets primaires / sous-tirets horaires secondaires gris),
                                                                          se démarque par la LUMINOSITÉ, sans teinte étrangère ni conflit avec la rampe d'usage -->
    <SolidColorBrush x:Key="Piste5h"             Color="#2A2932"/>    <!-- piste de l'arc 5 h -->
    <SolidColorBrush x:Key="PisteHebdo"          Color="#26252E"/>    <!-- piste de l'arc hebdo -->
    <SolidColorBrush x:Key="Piste24h"            Color="#242330"/>    <!-- piste de l'anneau timeline 24 h (nuance sombre proche des autres pistes) -->
    <SolidColorBrush x:Key="TextePrincipal"      Color="#F4F2EC"/>    <!-- countdown 5 h (principal) -->
    <!-- Deux nuances secondaires verrouillées, chacune un usage distinct (aucun token orphelin) : -->
    <SolidColorBrush x:Key="TexteSecondaireClair" Color="#C7C6D0"/>   <!-- countdown hebdo (vivant mais secondaire) -->
    <SolidColorBrush x:Key="TexteSecondaire"      Color="#A9A8B2"/>   <!-- badges/mentions annexes (estimée, épuisé, indisponible, périmée) -->
    <SolidColorBrush x:Key="Alerte"               Color="#EFA23A"/>   <!-- pastille de déconnexion (TOK-02). Repli STATIQUE = RampAmber du thème
                                                                           par défaut « minuit » ; ChronosTheme.BrushTokens() l'écrase par le RampAmber
                                                                           du thème actif. AMBRE et non rouge : le rouge signifie déjà « quota épuisé »
                                                                           dans la rampe d'usage, un rouge d'auth entrerait en collision sémantique. -->

    <!-- Palette du CHROME des fenêtres secondaires (réglages, historique) — promue de SettingsWindow.xaml en 34-01 (HIS-07),
         valeurs INCHANGÉES. Toujours sombre, indépendante du thème du cadran : PAS dans ChronosTheme.BrushTokens(). -->
    <SolidColorBrush x:Key="Panel"  Color="#151322"/>
    <SolidColorBrush x:Key="Panel2" Color="#1E1B30"/>
    <SolidColorBrush x:Key="Line"   Color="#2C2942"/>
    <SolidColorBrush x:Key="Ink"    Color="#F2F0FB"/>
    <SolidColorBrush x:Key="Ink2"   Color="#A9A6C4"/>
    <SolidColorBrush x:Key="Accent" Color="#8B7BF0"/>
    <SolidColorBrush x:Key="Ok"     Color="#4EC98A"/>
    <!-- Réglages v2 (DESIGN_PLAN_REGLAGES §2) : action DESTRUCTIVE uniquement (« Quitter Chronos »). Valeur de l'ancien littéral
         de SettingsWindow, inchangée : c'est la seule couleur ajoutée par la refonte. -->
    <SolidColorBrush x:Key="Danger" Color="#E8907F"/>

    <!-- Neutres de la fenêtre Historique (DESIGN_PLAN §2 / §2.0). Les tokens ne portent JAMAIS la rampe de quota :
         la couleur d'un niveau vient de ChronosTheme.ArcColor du thème actif. HistoGris = le gris « épuisé » du cadran (D-34-01). -->
    <SolidColorBrush x:Key="HistoTokens"    Color="#8C89A8"/>   <!-- barres de tokens (principal) -->
    <SolidColorBrush x:Key="HistoSousAgent" Color="#5A5776"/>   <!-- part sous-agents empilée -->
    <SolidColorBrush x:Key="HistoModele1"   Color="#9D9AB8"/>   <!-- vue Jour : 1er modèle par tokens de sortie -->
    <SolidColorBrush x:Key="HistoModele2"   Color="#6E6B8C"/>
    <SolidColorBrush x:Key="HistoModele3"   Color="#4A4762"/>
    <SolidColorBrush x:Key="HistoGris"      Color="#5A5960"/>   <!-- « épuisée », fantôme S-1, bordure d'un trou « Chronos arrêté » -->
    <DrawingBrush x:Key="HistoHachure" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">  <!-- zones « hors couverture » / « transcripts absents » (D-34-04) -->
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry><LineGeometry StartPoint="0,4" EndPoint="4,0"/></GeometryDrawing.Geometry>
                <GeometryDrawing.Pen><Pen Brush="{StaticResource HistoGris}" Thickness="1"/></GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Tailles de la fenêtre Historique (D-34-02) : corps §2, hauteurs de pistes §2.2 / §2.3, épaisseurs, opacités, gabarits.
         Un test de mise en page réel (34-06 / 34-07) vérifie les hauteurs sur l'arbre visuel — elles ne sont dupliquées nulle part en C#.
         Valeurs écrites avec un POINT (parseur XAML invariant), clés sans virgule. -->
    <!-- Corps de police (§2 : 16 / 14 / 11,5 / 11 / 10,5 / 9,5 / 9 / 8,5) -->
    <sys:Double x:Key="HistoCorpsTitre">16</sys:Double>
    <sys:Double x:Key="HistoCorpsGrand">14</sys:Double>
    <sys:Double x:Key="HistoCorpsNormal">11.5</sys:Double>
    <sys:Double x:Key="HistoCorpsMoyen">11</sys:Double>
    <sys:Double x:Key="HistoCorpsPetit">10.5</sys:Double>
    <sys:Double x:Key="HistoCorpsMini">9.5</sys:Double>
    <sys:Double x:Key="HistoCorpsLegende">9</sys:Double>
    <sys:Double x:Key="HistoCorpsInfime">8.5</sys:Double>
    <!-- Épaisseurs de trait et longueur des tirets de reset -->
    <sys:Double x:Key="HistoEpaisseurEscalier">2.2</sys:Double>
    <sys:Double x:Key="HistoEpaisseurPremierPlan">2.4</sys:Double>
    <sys:Double x:Key="HistoEpaisseurFin">1</sys:Double>
    <sys:Double x:Key="HistoEpaisseurBordureActive">1.5</sys:Double>
    <sys:Double x:Key="HistoLongueurTiretReset">8</sys:Double>
    <!-- Opacités (trou « Chronos arrêté », bande de couverture, ligne « maintenant ») -->
    <sys:Double x:Key="HistoOpaciteTrou">0.35</sys:Double>
    <sys:Double x:Key="HistoOpaciteCouverture">0.55</sys:Double>
    <sys:Double x:Key="HistoOpaciteMaintenant">0.6</sys:Double>
    <!-- Rayon des coins et gabarits de colonnes -->
    <sys:Double x:Key="HistoRayonCoins">16</sys:Double>
    <sys:Double x:Key="HistoLargeurLibelles">96</sys:Double>
    <sys:Double x:Key="HistoLargeurLegendeDroite">72</sys:Double>
    <!-- Hauteurs de pistes — Semaine (§2.2) -->
    <sys:Double x:Key="HistoHauteurNiveauPistes">150</sys:Double>
    <sys:Double x:Key="HistoHauteurRythmePistes">72</sys:Double>
    <sys:Double x:Key="HistoHauteurTokensPistes">72</sys:Double>
    <sys:Double x:Key="HistoHauteurCouverture">12</sys:Double>
    <!-- Jour (§2.3) -->
    <sys:Double x:Key="HistoHauteurNiveauJour">190</sys:Double>
    <sys:Double x:Key="HistoHauteurRythmeJour">64</sys:Double>
    <sys:Double x:Key="HistoHauteurTokensJour">64</sys:Double>
    <!-- Vue 4 semaines (DESIGN_PLAN §2.4, frame E, décision 2 de la phase 35 — D-35-14) : fantômes S-1 / S-2 / S-3 en HistoGris
         qui s'effacent avec l'âge, NIVEAU de 250, colonne d'étiquettes de 140 à droite, rangées de couverture de 10 au pas
         haut-à-haut de 16 (4 × 10 + 3 × 6 = 58). -->
    <sys:Double x:Key="HistoOpaciteSemaine1">0.8</sys:Double>
    <sys:Double x:Key="HistoOpaciteSemaine2">0.45</sys:Double>
    <sys:Double x:Key="HistoOpaciteSemaine3">0.25</sys:Double>
    <sys:Double x:Key="HistoHauteurNiveauQuatreSemaines">250</sys:Double>
    <sys:Double x:Key="HistoLargeurEtiquettesSemaines">140</sys:Double>
    <sys:Double x:Key="HistoHauteurCouvertureSemaine">10</sys:Double>
    <sys:Double x:Key="HistoPasCouvertureSemaines">16</sys:Double>
    <!-- Fenêtre : minimale 760 × 480, défaut 920 × 610 (§2) -->
    <sys:Double x:Key="HistoLargeurMin">760</sys:Double>
    <sys:Double x:Key="HistoHauteurMin">480</sys:Double>
    <sys:Double x:Key="HistoLargeurDefaut">920</sys:Double>
    <sys:Double x:Key="HistoHauteurDefaut">610</sys:Double>
    <!-- Gabarits de mise en page : rangée d'annotations au-dessus d'une piste, en-tête commun (§2.1) -->
    <sys:Double x:Key="HistoHauteurAnnotations">18</sys:Double>
    <sys:Double x:Key="HistoHauteurEnTete">92</sys:Double>
    <!-- Fenêtre de RÉGLAGES (quick 260927-reglages-v2, DESIGN_PLAN_REGLAGES §2) : fenêtre classique 860 × 580, minimum 640 × 440,
         rail de 208 à largeur fixe, colonne de lecture de 640 au plus (centrée au-delà). Grille de 4 px ; les gabarits repris de
         l'ancienne fenêtre (interrupteur 40 × 23 → 40 × 24, bouton 17 → 16 ; vignette 88 × 74 → 88 × 76) y sont ramenés. -->
    <sys:Double x:Key="ReglagesLargeurMin">640</sys:Double>
    <sys:Double x:Key="ReglagesHauteurMin">440</sys:Double>
    <sys:Double x:Key="ReglagesLargeurDefaut">860</sys:Double>
    <sys:Double x:Key="ReglagesHauteurDefaut">580</sys:Double>
    <sys:Double x:Key="ReglagesRailLargeur">208</sys:Double>
    <sys:Double x:Key="ReglagesContenuMax">640</sys:Double>
    <sys:Double x:Key="ReglagesHauteurBarreTitre">40</sys:Double>
    <sys:Double x:Key="ReglagesLargeurBoutonFenetre">44</sys:Double>
    <sys:Double x:Key="ReglagesHauteurEntreeRail">36</sys:Double>
    <!-- Typographie : titre de section 18 · titre de carte 13 · corps / aide 11 · libellé du rail 12 · étiquette 10,5 · mini 9,5 -->
    <sys:Double x:Key="ReglagesCorpsTitreSection">18</sys:Double>
    <sys:Double x:Key="ReglagesCorpsTitreCarte">13</sys:Double>
    <sys:Double x:Key="ReglagesCorpsAide">11</sys:Double>
    <sys:Double x:Key="ReglagesCorpsRail">12</sys:Double>
    <sys:Double x:Key="ReglagesCorpsEtiquette">10.5</sys:Double>
    <sys:Double x:Key="ReglagesCorpsMini">9.5</sys:Double>
    <!-- Gabarits : interrupteur, vignette de thème, aperçus, logo, trait de sélection du rail, pastille, barre de défilement -->
    <sys:Double x:Key="ReglagesInterrupteurLargeur">40</sys:Double>
    <sys:Double x:Key="ReglagesInterrupteurHauteur">24</sys:Double>
    <sys:Double x:Key="ReglagesInterrupteurBouton">16</sys:Double>
    <sys:Double x:Key="ReglagesVignetteLargeur">88</sys:Double>
    <sys:Double x:Key="ReglagesVignetteHauteur">76</sys:Double>
    <sys:Double x:Key="ReglagesVignetteDisque">32</sys:Double>
    <sys:Double x:Key="ReglagesVignettePastille">8</sys:Double>
    <sys:Double x:Key="ReglagesApercuCadran">144</sys:Double>
    <sys:Double x:Key="ReglagesApercuSessionsHauteur">120</sys:Double>
    <sys:Double x:Key="ReglagesLogo">16</sys:Double>
    <sys:Double x:Key="ReglagesLogoTrait">3</sys:Double>
    <sys:Double x:Key="ReglagesTraitSelection">3</sys:Double>
    <sys:Double x:Key="ReglagesPastille">10</sys:Double>
    <sys:Double x:Key="ReglagesBarreDefilement">8</sys:Double>
    <sys:Double x:Key="ReglagesOpaciteInactif">0.45</sys:Double>

    <!-- Seul token non-double : bord de redimensionnement (WindowChrome.ResizeBorderThickness, 34-05). -->
    <Thickness x:Key="HistoBordRedimensionnement">6</Thickness>

    <!-- Converters : rampe d'utilization (05-02) + BooleanToVisibility intégré WPF. -->
    <conv:UtilizationToBrushConverter x:Key="UtilBrush"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
</ResourceDictionary>
