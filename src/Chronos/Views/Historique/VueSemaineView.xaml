<UserControl x:Class="Chronos.Views.Historique.VueSemaineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:hc="clr-namespace:Chronos.Controls.Historique"
             xmlns:conv="clr-namespace:Chronos.Converters"
             xmlns:txt="clr-namespace:Chronos.Text"
             xmlns:mh="clr-namespace:Chronos.Models.Historique">
    <!--
        (Pas de UseLayoutRounding ici : hérité de la fenêtre hôte. Posé sur la vue, il arrondirait 150 DIP au pixel physique à 125 %
        d'échelle → ActualHeight 150,4 ; le test de la table §2.2 mesure la vue seule, en DIP.)
        HIS-02 / HIS-03 — vue « Semaine de forfait » (DESIGN_PLAN §2.2) en XAML PUR : aucune logique, aucun chiffre, aucun mot.
        D-34-27 : trois Grid nommées (StylePistes / StyleSimplifie / StyleTuiles), une seule visible (DataTrigger sur IsStyleX),
                  chacune avec SES pistes — la table des hauteurs §2.2 n'est écrite qu'une fois, dans les tokens HistoHauteur*.
        D-34-28 : le corps défile verticalement ; l'axe des jours et les pieds restent hors du défilement.
        D-34-29 : une piste = une rangée de trois colonnes (libellé HistoLargeurLibelles / piste * / légende HistoLargeurLegendeDroite) ;
                  les annotations (trous, journal ouvert, sauts) sont des TextBlock posés par instant (InstantVersXConverter) dans des
                  rangées HistoHauteurAnnotations au-dessus et au-dessous de NIVEAU.
        D-34-30 : zone antérieure au journal = Rectangle HistoHachure derrière NIVEAU, de Plage.Debut à AnnotationJournalOuvert.Debut
                  (LargeurIntervalleConverter), visible seulement quand l'annotation existe ; le mot « journal ouvert le … » est l'annotation.
        Surcouche : une SurcoucheReticule par grille (RowSpan sur toutes les pistes) ; l'infobulle est un Border bindé à ses DP en lecture
                  seule (XReticule / TexteInfobulle / InfobulleVisible) — non bornée au bord droit en phase 34 (noté pour la revue).
        DataContext : HistoriqueViewModel (hérité de HistoriqueWindow). Le dictionnaire des tokens est fusionné ICI aussi : la vue se
        monte seule dans les tests (VueSemaineBindingTests mesure l'arbre visuel réel). Pitfall 5 : TickReset / Alerte en DynamicResource.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Chronos;component/Resources/DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InstantVersXConverter x:Key="InstantVersX"/>
            <conv:LargeurIntervalleConverter x:Key="LargeurIntervalle"/>

            <!-- Espacement vertical entre deux pistes (marge, pas une hauteur : les ActualHeight des pistes restent celles des tokens). -->
            <Thickness x:Key="HistoMargePiste">0,0,0,6</Thickness>
            <Thickness x:Key="HistoMargeLibelle">0,2,8,0</Thickness>
            <Thickness x:Key="HistoMargeLegendeDroite">8,2,0,0</Thickness>
            <Thickness x:Key="HistoMargeLibellePermanent">0,0,0,4</Thickness>
            <Thickness x:Key="HistoMargePieds">0,6,0,0</Thickness>
            <Thickness x:Key="HistoMargePiedDivergence">0,3,0,0</Thickness>
            <Thickness x:Key="HistoMargeCarreDivergence">0,0,6,0</Thickness>
            <!-- Locaux nommés (le dictionnaire commun est fermé à 38 sys:Double — promotion possible en 34-08) : côté du carré témoin du
                 pied « cadre violet », bordure et décalage vertical de l'infobulle. -->
            <sys:Double x:Key="HistoCoteCarreDivergence">10</sys:Double>
            <sys:Double x:Key="HistoDecalageInfobulle">8</sys:Double>
            <Thickness x:Key="HistoBordureInfobulle">1</Thickness>

            <!-- Colonne des libellés (gauche) et colonne des légendes (droite) : mêmes largeurs dans l'axe des jours et dans les grilles. -->
            <Style x:Key="CelluleLibelles" TargetType="StackPanel">
                <Setter Property="Width" Value="{StaticResource HistoLargeurLibelles}"/>
                <Setter Property="Margin" Value="{StaticResource HistoMargeLibelle}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="CelluleDroite" TargetType="StackPanel">
                <Setter Property="Width" Value="{StaticResource HistoLargeurLegendeDroite}"/>
                <Setter Property="Margin" Value="{StaticResource HistoMargeLegendeDroite}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="LibellePiste" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
                <Setter Property="FontSize" Value="{StaticResource HistoCorpsLegende}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="Repere" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
                <Setter Property="FontSize" Value="{StaticResource HistoCorpsInfime}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Annotation" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
                <Setter Property="FontSize" Value="{StaticResource HistoCorpsInfime}"/>
            </Style>
            <Style x:Key="Pied" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
                <Setter Property="FontSize" Value="{StaticResource HistoCorpsMini}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Une grille de style est cachée par défaut ; chaque grille pose SON DataTrigger IsStyleX → Visible. -->
            <Style x:Key="GrilleStyle" TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>

            <!-- Éléments posés à leur instant sur un Canvas qui remplit la colonne des pistes : Canvas.Left = InstantVersX(instant, plage,
                 largeur du Canvas). Les graduations portent Instant, les annotations Debut. -->
            <ItemsPanelTemplate x:Key="PanneauCanvas">
                <Canvas/>
            </ItemsPanelTemplate>
            <Style x:Key="PoseParInstant" TargetType="ContentPresenter">
                <Setter Property="Canvas.Left">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource InstantVersX}">
                            <Binding Path="Instant"/>
                            <Binding Path="DataContext.DonneesSemaine.Plage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PoseParDebut" TargetType="ContentPresenter">
                <Setter Property="Canvas.Left">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource InstantVersX}">
                            <Binding Path="Debut"/>
                            <Binding Path="DataContext.DonneesSemaine.Plage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="TplGraduation">
                <TextBlock Style="{StaticResource Annotation}" Text="{Binding Texte}"/>
            </DataTemplate>
            <!-- Annotation d'honnêteté : le mot vient du VM (TextesHistorique), la vue n'invente rien. -->
            <DataTemplate x:Key="TplAnnotation">
                <TextBlock Style="{StaticResource Annotation}" Text="{Binding Texte}"/>
            </DataTemplate>
            <!-- Trou : gris (Ink2) si « Chronos arrêté » / cause inconnue, ambre (Alerte, thème) si jeton invalide ou sonde refusée. -->
            <DataTemplate x:Key="TplTrou">
                <TextBlock Text="{Binding Texte}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Annotation}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cause}" Value="{x:Static mh:CauseTrou.JetonInvalide}">
                                    <Setter Property="Foreground" Value="{DynamicResource Alerte}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cause}" Value="{x:Static mh:CauseTrou.SondeRefusee}">
                                    <Setter Property="Foreground" Value="{DynamicResource Alerte}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
            <!-- Marqueur « journal ouvert le <date> » : posé à l'instant d'ouverture, absent si le journal est antérieur à la plage. -->
            <Style x:Key="MarqueurJournal" TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource TplAnnotation}"/>
                <Setter Property="Canvas.Left">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource InstantVersX}">
                            <Binding Path="AnnotationJournalOuvert.Debut"/>
                            <Binding Path="DonneesSemaine.Plage"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnotationJournalOuvert}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- D-34-30 : zone antérieure au journal, derrière NIVEAU (largeur = Plage.Debut → ouverture du journal, sur la largeur de la cellule). -->
            <Style x:Key="ZoneAvantJournal" TargetType="Rectangle">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Opacity" Value="{StaticResource HistoOpaciteTrou}"/>
                <Setter Property="Width">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource LargeurIntervalle}">
                            <Binding Path="DonneesSemaine.Plage.Debut"/>
                            <Binding Path="AnnotationJournalOuvert.Debut"/>
                            <Binding Path="DonneesSemaine.Plage"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnotationJournalOuvert}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Infobulle du réticule : Panel2 bordé de Line, quatre lignes Ink ; suit XReticule de la surcouche de sa grille. -->
            <Style x:Key="Infobulle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Panel2}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="{StaticResource HistoBordureInfobulle}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Canvas.Top" Value="{StaticResource HistoDecalageInfobulle}"/>
            </Style>
            <Style x:Key="TexteInfobulle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontSize" Value="{StaticResource HistoCorpsPetit}"/>
            </Style>
            <!-- Grille verticale par jour (§2.2), derrière les pistes : un trait Line de HistoEpaisseurFin sur toute la hauteur du Canvas. -->
            <DataTemplate x:Key="TplLigneJour">
                <Rectangle Fill="{StaticResource Line}" Width="{StaticResource HistoEpaisseurFin}"
                           Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Racine">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= [0] Axe des jours (hors défilement) : sam. 19 … ven. 25 à leurs minuits locaux, « reset hebdo → » ================= -->
        <Grid Grid.Row="0" Height="{StaticResource HistoHauteurAnnotations}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource CelluleLibelles}"/>
            <!-- Largeur = celle de la colonne des pistes DANS le défilement (MesureColonnePistes) : les libellés restent alignés sur
                 les pistes même quand la barre de défilement verticale apparaît. -->
            <ItemsControl x:Name="AxeJours" Grid.Column="1" HorizontalAlignment="Left" IsHitTestVisible="False"
                          Width="{Binding ActualWidth, ElementName=MesureColonnePistes}"
                          ItemsSource="{Binding LibellesJours}" ItemsPanel="{StaticResource PanneauCanvas}"
                          ItemContainerStyle="{StaticResource PoseParInstant}" ItemTemplate="{StaticResource TplGraduation}"/>
            <StackPanel Grid.Column="2" Style="{StaticResource CelluleDroite}">
                <TextBlock Style="{StaticResource Repere}" Text="{x:Static txt:TextesHistorique.ResetHebdo}"/>
            </StackPanel>
        </Grid>

        <!-- ================= [1] Corps : les trois grilles de style superposées, une seule visible (D-34-27), défilement vertical (D-34-28) ================= -->
        <ScrollViewer Grid.Row="1" x:Name="Defilement" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid x:Name="Corps">
                <!-- Témoin de largeur : mêmes colonnes que les grilles de style, hauteur nulle ; l'axe des jours s'aligne dessus. -->
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Style="{StaticResource CelluleLibelles}"/>
                    <Border x:Name="MesureColonnePistes" Grid.Column="1"/>
                    <StackPanel Grid.Column="2" Style="{StaticResource CelluleDroite}"/>
                </Grid>

                <!-- ============ Style A « Pistes » : NIVEAU 150 / RYTHME 72 / TOKENS 72 / COUVERTURE 12 ============ -->
                <Grid x:Name="StylePistes">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource GrilleStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStylePistes}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0 annotations : trous, journal ouvert -->
                        <RowDefinition Height="Auto"/>  <!-- 1 NIVEAU -->
                        <RowDefinition Height="Auto"/>  <!-- 2 annotations : sauts -->
                        <RowDefinition Height="Auto"/>  <!-- 3 RYTHME -->
                        <RowDefinition Height="Auto"/>  <!-- 4 TOKENS -->
                        <RowDefinition Height="Auto"/>  <!-- 5 libellé permanent des tokens -->
                        <RowDefinition Height="Auto"/>  <!-- 6 COUVERTURE -->
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Column="1" Grid.Row="1" Grid.RowSpan="6" IsHitTestVisible="False" ItemsSource="{Binding LibellesJours}"
                                  ItemsPanel="{StaticResource PanneauCanvas}" ItemContainerStyle="{StaticResource PoseParInstant}" ItemTemplate="{StaticResource TplLigneJour}"/>

                    <!-- Annotations d'honnêteté : trous (+ journal ouvert) au-dessus de NIVEAU, sauts au-dessous (D-34-29). -->
                    <Grid Grid.Row="0" Grid.Column="1" Height="{StaticResource HistoHauteurAnnotations}">
                        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding AnnotationsTrous}" ItemsPanel="{StaticResource PanneauCanvas}"
                                      ItemContainerStyle="{StaticResource PoseParDebut}" ItemTemplate="{StaticResource TplTrou}"/>
                        <Canvas IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource MarqueurJournal}" Content="{Binding AnnotationJournalOuvert}"/>
                        </Canvas>
                    </Grid>
                    <ItemsControl Grid.Row="2" Grid.Column="1" Height="{StaticResource HistoHauteurAnnotations}" IsHitTestVisible="False"
                                  ItemsSource="{Binding AnnotationsSauts}" ItemsPanel="{StaticResource PanneauCanvas}"
                                  ItemContainerStyle="{StaticResource PoseParDebut}" ItemTemplate="{StaticResource TplAnnotation}"/>

                    <!-- NIVEAU -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteNiveau}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="{StaticResource HistoMargePiste}">
                        <Rectangle x:Name="ZoneAvantJournalPistes" Style="{StaticResource ZoneAvantJournal}" Fill="{StaticResource HistoHachure}"/>
                        <hc:PisteNiveau Height="{StaticResource HistoHauteurNiveauPistes}" Variante="SemaineComplete"
                                        Plage="{Binding DonneesSemaine.Plage}" Analyse="{Binding DonneesSemaine.Analyse}"
                                        Precedente="{Binding DonneesSemaine.Precedente}" PlagePrecedente="{Binding DonneesSemaine.PlagePrecedente}"
                                        Divergences="{Binding DonneesSemaine.Divergences}" InstantLecture="{Binding DonneesSemaine.LueA}"
                                        Rampe="{Binding Theme}" TraitReset="{DynamicResource TickReset}" TraitFin="{StaticResource Ink2}"
                                        Gris="{StaticResource HistoGris}" FondTrou="{StaticResource Line}" BordTrouArrete="{StaticResource HistoGris}"
                                        BordTrouJeton="{DynamicResource Alerte}" CadreDivergence="{StaticResource Accent}" Grille="{StaticResource Line}"
                                        EpaisseurEscalier="{StaticResource HistoEpaisseurEscalier}" EpaisseurPremierPlan="{StaticResource HistoEpaisseurPremierPlan}"
                                        EpaisseurFine="{StaticResource HistoEpaisseurFin}" LongueurTiretReset="{StaticResource HistoLongueurTiretReset}"
                                        OpaciteTrou="{StaticResource HistoOpaciteTrou}"/>
                    </Grid>

                    <!-- RYTHME -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteRythme}"/>
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding EchelleRythme}"/>
                    </StackPanel>
                    <hc:PisteRythme Grid.Row="3" Grid.Column="1" Height="{StaticResource HistoHauteurRythmePistes}" Margin="{StaticResource HistoMargePiste}"
                                    Plage="{Binding DonneesSemaine.Plage}" Deltas="{Binding DonneesSemaine.Analyse.Deltas5h}" Serie="{Binding DonneesSemaine.Analyse.Serie}"
                                    Rampe="{Binding Theme}" Grille="{StaticResource Line}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>

                    <!-- TOKENS CLAUDE CODE -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteTokens}"/>
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding EchelleTokens}"/>
                    </StackPanel>
                    <hc:PisteTokens Grid.Row="4" Grid.Column="1" Height="{StaticResource HistoHauteurTokensPistes}" Margin="{StaticResource HistoMargePiste}"
                                    Plage="{Binding DonneesSemaine.Plage}" Barres="{Binding DonneesSemaine.Barres}" Plafond="{Binding PlafondTokens}"
                                    InstantLecture="{Binding DonneesSemaine.LueA}" Principal="{StaticResource HistoTokens}" SousAgents="{StaticResource HistoSousAgent}"
                                    Hachure="{StaticResource HistoHachure}" Grille="{StaticResource Line}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>
                    <StackPanel Grid.Row="4" Grid.Column="2" Style="{StaticResource CelluleDroite}">
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding LegendeTokens}"/>
                    </StackPanel>

                    <!-- COUVERTURE -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteCouverture}"/>
                    </StackPanel>
                    <hc:PisteCouverture Grid.Row="6" Grid.Column="1" Height="{StaticResource HistoHauteurCouverture}"
                                        Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Trous="{Binding DonneesSemaine.Analyse.Trous}"
                                        InstantLecture="{Binding DonneesSemaine.LueA}" Present="{StaticResource Ok}" OpacitePresent="{StaticResource HistoOpaciteCouverture}"
                                        Arrete="{StaticResource Line}" Jeton="{DynamicResource Alerte}"/>

                    <!-- Libellé permanent des tokens (grain « par heure », D-34-14). -->
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Pied}" Text="{Binding LibellePermanentTokens}"
                               Margin="{StaticResource HistoMargeLibellePermanent}"/>

                    <!-- Surcouche réticule (la seule à bouger au survol) + infobulle, sur toutes les rangées de pistes. -->
                    <hc:SurcoucheReticule x:Name="SurcouchePistes" Grid.Column="1" Grid.Row="1" Grid.RowSpan="6"
                                          Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Maintenant="{Binding Maintenant}"
                                          AfficherMaintenant="False" InstantLecture="{Binding DonneesSemaine.LueA}" Fuseau="{Binding Fuseau}"
                                          TraitReticule="{StaticResource Ink2}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>
                    <Canvas Grid.Column="1" Grid.Row="1" Grid.RowSpan="6" IsHitTestVisible="False">
                        <Border x:Name="InfobullePistes" Style="{StaticResource Infobulle}" Canvas.Left="{Binding XReticule, ElementName=SurcouchePistes}"
                                Visibility="{Binding InfobulleVisible, ElementName=SurcouchePistes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TexteInfobulle}" Text="{Binding TexteInfobulle, ElementName=SurcouchePistes}"/>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- ============ Style B « Simplifié » : NIVEAU 200 / TOKENS 90 / COUVERTURE 12 ============ -->
                <Grid x:Name="StyleSimplifie">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource GrilleStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStyleSimplifie}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0 annotations : trous, journal ouvert -->
                        <RowDefinition Height="Auto"/>  <!-- 1 NIVEAU -->
                        <RowDefinition Height="Auto"/>  <!-- 2 annotations : sauts -->
                        <RowDefinition Height="Auto"/>  <!-- 3 TOKENS -->
                        <RowDefinition Height="Auto"/>  <!-- 4 libellé permanent des tokens -->
                        <RowDefinition Height="Auto"/>  <!-- 5 COUVERTURE -->
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Column="1" Grid.Row="1" Grid.RowSpan="5" IsHitTestVisible="False" ItemsSource="{Binding LibellesJours}"
                                  ItemsPanel="{StaticResource PanneauCanvas}" ItemContainerStyle="{StaticResource PoseParInstant}" ItemTemplate="{StaticResource TplLigneJour}"/>

                    <!-- Annotations d'honnêteté : trous (+ journal ouvert) au-dessus de NIVEAU, sauts au-dessous (D-34-29). -->
                    <Grid Grid.Row="0" Grid.Column="1" Height="{StaticResource HistoHauteurAnnotations}">
                        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding AnnotationsTrous}" ItemsPanel="{StaticResource PanneauCanvas}"
                                      ItemContainerStyle="{StaticResource PoseParDebut}" ItemTemplate="{StaticResource TplTrou}"/>
                        <Canvas IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource MarqueurJournal}" Content="{Binding AnnotationJournalOuvert}"/>
                        </Canvas>
                    </Grid>
                    <ItemsControl Grid.Row="2" Grid.Column="1" Height="{StaticResource HistoHauteurAnnotations}" IsHitTestVisible="False"
                                  ItemsSource="{Binding AnnotationsSauts}" ItemsPanel="{StaticResource PanneauCanvas}"
                                  ItemContainerStyle="{StaticResource PoseParDebut}" ItemTemplate="{StaticResource TplAnnotation}"/>

                    <!-- NIVEAU -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteNiveau}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="{StaticResource HistoMargePiste}">
                        <Rectangle x:Name="ZoneAvantJournalSimplifie" Style="{StaticResource ZoneAvantJournal}" Fill="{StaticResource HistoHachure}"/>
                        <hc:PisteNiveau Height="{StaticResource HistoHauteurNiveauSimplifie}" Variante="SemaineComplete"
                                        Plage="{Binding DonneesSemaine.Plage}" Analyse="{Binding DonneesSemaine.Analyse}"
                                        Precedente="{Binding DonneesSemaine.Precedente}" PlagePrecedente="{Binding DonneesSemaine.PlagePrecedente}"
                                        Divergences="{Binding DonneesSemaine.Divergences}" InstantLecture="{Binding DonneesSemaine.LueA}"
                                        Rampe="{Binding Theme}" TraitReset="{DynamicResource TickReset}" TraitFin="{StaticResource Ink2}"
                                        Gris="{StaticResource HistoGris}" FondTrou="{StaticResource Line}" BordTrouArrete="{StaticResource HistoGris}"
                                        BordTrouJeton="{DynamicResource Alerte}" CadreDivergence="{StaticResource Accent}" Grille="{StaticResource Line}"
                                        EpaisseurEscalier="{StaticResource HistoEpaisseurEscalier}" EpaisseurPremierPlan="{StaticResource HistoEpaisseurPremierPlan}"
                                        EpaisseurFine="{StaticResource HistoEpaisseurFin}" LongueurTiretReset="{StaticResource HistoLongueurTiretReset}"
                                        OpaciteTrou="{StaticResource HistoOpaciteTrou}"/>
                    </Grid>

                    <!-- TOKENS CLAUDE CODE -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteTokens}"/>
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding EchelleTokens}"/>
                    </StackPanel>
                    <hc:PisteTokens Grid.Row="3" Grid.Column="1" Height="{StaticResource HistoHauteurTokensSimplifie}" Margin="{StaticResource HistoMargePiste}"
                                    Plage="{Binding DonneesSemaine.Plage}" Barres="{Binding DonneesSemaine.Barres}" Plafond="{Binding PlafondTokens}"
                                    InstantLecture="{Binding DonneesSemaine.LueA}" Principal="{StaticResource HistoTokens}" SousAgents="{StaticResource HistoSousAgent}"
                                    Hachure="{StaticResource HistoHachure}" Grille="{StaticResource Line}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>
                    <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource CelluleDroite}">
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding LegendeTokens}"/>
                    </StackPanel>

                    <!-- COUVERTURE -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteCouverture}"/>
                    </StackPanel>
                    <hc:PisteCouverture Grid.Row="5" Grid.Column="1" Height="{StaticResource HistoHauteurCouverture}"
                                        Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Trous="{Binding DonneesSemaine.Analyse.Trous}"
                                        InstantLecture="{Binding DonneesSemaine.LueA}" Present="{StaticResource Ok}" OpacitePresent="{StaticResource HistoOpaciteCouverture}"
                                        Arrete="{StaticResource Line}" Jeton="{DynamicResource Alerte}"/>

                    <!-- Libellé permanent des tokens (grain « par heure », D-34-14). -->
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Pied}" Text="{Binding LibellePermanentTokens}"
                               Margin="{StaticResource HistoMargeLibellePermanent}"/>

                    <!-- Surcouche réticule (la seule à bouger au survol) + infobulle, sur toutes les rangées de pistes. -->
                    <hc:SurcoucheReticule x:Name="SurcoucheSimplifie" Grid.Column="1" Grid.Row="1" Grid.RowSpan="5"
                                          Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Maintenant="{Binding Maintenant}"
                                          AfficherMaintenant="False" InstantLecture="{Binding DonneesSemaine.LueA}" Fuseau="{Binding Fuseau}"
                                          TraitReticule="{StaticResource Ink2}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>
                    <Canvas Grid.Column="1" Grid.Row="1" Grid.RowSpan="5" IsHitTestVisible="False">
                        <Border x:Name="InfobulleSimplifie" Style="{StaticResource Infobulle}" Canvas.Left="{Binding XReticule, ElementName=SurcoucheSimplifie}"
                                Visibility="{Binding InfobulleVisible, ElementName=SurcoucheSimplifie, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TexteInfobulle}" Text="{Binding TexteInfobulle, ElementName=SurcoucheSimplifie}"/>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- ============ Style C « Tuiles » : NIVEAU 120 (hebdo seul) / FENÊTRES 5 H 62 / RYTHME 58 / TOKENS 58 / COUVERTURE 12 ============ -->
                <Grid x:Name="StyleTuiles">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource GrilleStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStyleTuiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0 annotations : trous, journal ouvert -->
                        <RowDefinition Height="Auto"/>  <!-- 1 NIVEAU (hebdo seul) -->
                        <RowDefinition Height="Auto"/>  <!-- 2 annotations : sauts -->
                        <RowDefinition Height="Auto"/>  <!-- 3 FENÊTRES 5 H -->
                        <RowDefinition Height="Auto"/>  <!-- 4 RYTHME -->
                        <RowDefinition Height="Auto"/>  <!-- 5 TOKENS -->
                        <RowDefinition Height="Auto"/>  <!-- 6 libellé permanent des tokens -->
                        <RowDefinition Height="Auto"/>  <!-- 7 COUVERTURE -->
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Column="1" Grid.Row="1" Grid.RowSpan="7" IsHitTestVisible="False" ItemsSource="{Binding LibellesJours}"
                                  ItemsPanel="{StaticResource PanneauCanvas}" ItemContainerStyle="{StaticResource PoseParInstant}" ItemTemplate="{StaticResource TplLigneJour}"/>

                    <!-- Annotations d'honnêteté : trous (+ journal ouvert) au-dessus de NIVEAU, sauts au-dessous (D-34-29). -->
                    <Grid Grid.Row="0" Grid.Column="1" Height="{StaticResource HistoHauteurAnnotations}">
                        <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding AnnotationsTrous}" ItemsPanel="{StaticResource PanneauCanvas}"
                                      ItemContainerStyle="{StaticResource PoseParDebut}" ItemTemplate="{StaticResource TplTrou}"/>
                        <Canvas IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource MarqueurJournal}" Content="{Binding AnnotationJournalOuvert}"/>
                        </Canvas>
                    </Grid>
                    <ItemsControl Grid.Row="2" Grid.Column="1" Height="{StaticResource HistoHauteurAnnotations}" IsHitTestVisible="False"
                                  ItemsSource="{Binding AnnotationsSauts}" ItemsPanel="{StaticResource PanneauCanvas}"
                                  ItemContainerStyle="{StaticResource PoseParDebut}" ItemTemplate="{StaticResource TplAnnotation}"/>

                    <!-- NIVEAU : hebdo seul (les fenêtres 5 h ont leur propre piste en C) -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteNiveau}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="{StaticResource HistoMargePiste}">
                        <Rectangle x:Name="ZoneAvantJournalTuiles" Style="{StaticResource ZoneAvantJournal}" Fill="{StaticResource HistoHachure}"/>
                        <hc:PisteNiveau Height="{StaticResource HistoHauteurNiveauTuiles}" Variante="SemaineHebdoSeul"
                                        Plage="{Binding DonneesSemaine.Plage}" Analyse="{Binding DonneesSemaine.Analyse}"
                                        Precedente="{Binding DonneesSemaine.Precedente}" PlagePrecedente="{Binding DonneesSemaine.PlagePrecedente}"
                                        Divergences="{Binding DonneesSemaine.Divergences}" InstantLecture="{Binding DonneesSemaine.LueA}"
                                        Rampe="{Binding Theme}" TraitReset="{DynamicResource TickReset}" TraitFin="{StaticResource Ink2}"
                                        Gris="{StaticResource HistoGris}" FondTrou="{StaticResource Line}" BordTrouArrete="{StaticResource HistoGris}"
                                        BordTrouJeton="{DynamicResource Alerte}" CadreDivergence="{StaticResource Accent}" Grille="{StaticResource Line}"
                                        EpaisseurEscalier="{StaticResource HistoEpaisseurEscalier}" EpaisseurPremierPlan="{StaticResource HistoEpaisseurPremierPlan}"
                                        EpaisseurFine="{StaticResource HistoEpaisseurFin}" LongueurTiretReset="{StaticResource HistoLongueurTiretReset}"
                                        OpaciteTrou="{StaticResource HistoOpaciteTrou}"/>
                    </Grid>

                    <!-- FENÊTRES 5 H -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteFenetres5h}"/>
                    </StackPanel>
                    <hc:PisteFenetres5h Grid.Row="3" Grid.Column="1" Height="{StaticResource HistoHauteurFenetres5hTuiles}" Margin="{StaticResource HistoMargePiste}"
                                        Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Rampe="{Binding Theme}"
                                        Gris="{StaticResource HistoGris}" TraitReset="{DynamicResource TickReset}" Grille="{StaticResource Line}"
                                        EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>

                    <!-- RYTHME -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteRythme}"/>
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding EchelleRythme}"/>
                    </StackPanel>
                    <hc:PisteRythme Grid.Row="4" Grid.Column="1" Height="{StaticResource HistoHauteurRythmeTuiles}" Margin="{StaticResource HistoMargePiste}"
                                    Plage="{Binding DonneesSemaine.Plage}" Deltas="{Binding DonneesSemaine.Analyse.Deltas5h}" Serie="{Binding DonneesSemaine.Analyse.Serie}"
                                    Rampe="{Binding Theme}" Grille="{StaticResource Line}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>

                    <!-- TOKENS CLAUDE CODE -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteTokens}"/>
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding EchelleTokens}"/>
                    </StackPanel>
                    <hc:PisteTokens Grid.Row="5" Grid.Column="1" Height="{StaticResource HistoHauteurTokensTuiles}" Margin="{StaticResource HistoMargePiste}"
                                    Plage="{Binding DonneesSemaine.Plage}" Barres="{Binding DonneesSemaine.Barres}" Plafond="{Binding PlafondTokens}"
                                    InstantLecture="{Binding DonneesSemaine.LueA}" Principal="{StaticResource HistoTokens}" SousAgents="{StaticResource HistoSousAgent}"
                                    Hachure="{StaticResource HistoHachure}" Grille="{StaticResource Line}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>
                    <StackPanel Grid.Row="5" Grid.Column="2" Style="{StaticResource CelluleDroite}">
                        <TextBlock Style="{StaticResource Repere}" Text="{Binding LegendeTokens}"/>
                    </StackPanel>

                    <!-- COUVERTURE -->
                    <StackPanel Grid.Row="7" Grid.Column="0" Style="{StaticResource CelluleLibelles}">
                        <TextBlock Style="{StaticResource LibellePiste}" Text="{x:Static txt:TextesHistorique.PisteCouverture}"/>
                    </StackPanel>
                    <hc:PisteCouverture Grid.Row="7" Grid.Column="1" Height="{StaticResource HistoHauteurCouverture}"
                                        Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Trous="{Binding DonneesSemaine.Analyse.Trous}"
                                        InstantLecture="{Binding DonneesSemaine.LueA}" Present="{StaticResource Ok}" OpacitePresent="{StaticResource HistoOpaciteCouverture}"
                                        Arrete="{StaticResource Line}" Jeton="{DynamicResource Alerte}"/>

                    <!-- Libellé permanent des tokens (grain « par heure », D-34-14). -->
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Pied}" Text="{Binding LibellePermanentTokens}"
                               Margin="{StaticResource HistoMargeLibellePermanent}"/>

                    <!-- Surcouche réticule (la seule à bouger au survol) + infobulle, sur toutes les rangées de pistes. -->
                    <hc:SurcoucheReticule x:Name="SurcoucheTuiles" Grid.Column="1" Grid.Row="1" Grid.RowSpan="7"
                                          Plage="{Binding DonneesSemaine.Plage}" Serie="{Binding DonneesSemaine.Analyse.Serie}" Maintenant="{Binding Maintenant}"
                                          AfficherMaintenant="False" InstantLecture="{Binding DonneesSemaine.LueA}" Fuseau="{Binding Fuseau}"
                                          TraitReticule="{StaticResource Ink2}" EpaisseurFine="{StaticResource HistoEpaisseurFin}"/>
                    <Canvas Grid.Column="1" Grid.Row="1" Grid.RowSpan="7" IsHitTestVisible="False">
                        <Border x:Name="InfobulleTuiles" Style="{StaticResource Infobulle}" Canvas.Left="{Binding XReticule, ElementName=SurcoucheTuiles}"
                                Visibility="{Binding InfobulleVisible, ElementName=SurcoucheTuiles, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TexteInfobulle}" Text="{Binding TexteInfobulle, ElementName=SurcoucheTuiles}"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================= [2] Pieds (hors défilement) : pied de page fixe + « cadre violet : … » quand une divergence existe ================= -->
        <StackPanel Grid.Row="2" Margin="{StaticResource HistoMargePieds}">
            <TextBlock Style="{StaticResource Pied}" Text="{Binding PiedDePage}"/>
            <StackPanel x:Name="PiedDivergence" Orientation="Horizontal" Margin="{StaticResource HistoMargePiedDivergence}"
                        Visibility="{Binding AfficherPiedDivergence, Converter={StaticResource BoolToVis}}">
                <Rectangle Width="{StaticResource HistoCoteCarreDivergence}" Height="{StaticResource HistoCoteCarreDivergence}"
                           Stroke="{StaticResource Accent}" StrokeDashArray="3 2" StrokeThickness="{StaticResource HistoEpaisseurFin}"
                           VerticalAlignment="Center" Margin="{StaticResource HistoMargeCarreDivergence}"/>
                <TextBlock Style="{StaticResource Pied}" Text="{Binding TextePiedDivergence}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
