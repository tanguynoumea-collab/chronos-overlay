<Window x:Class="Chronos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cadv="clr-namespace:Chronos.Views.Cadrans"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="Manual"
        Width="{Binding LargeurCadran, Mode=OneWay}" Height="{Binding HauteurFenetre, Mode=OneWay}" WindowStartupLocation="Manual">
    <!-- Cadran complet (Pattern 6 : empilement du fond vers le premier plan).
         Aucune Storyboard/blur/shadow : AllowsTransparency force le rendu logiciel.
         Aucun code-behind : uniquement des bindings + converters.
         Refonte visuelle : le style est sélectionnable (Anneaux / Braises / Fusible / Marée / Volets),
         un seul groupe visible à la fois (IsStyleX).
         Phase 40 (CAD-01 / CAD-04) : plus aucun Viewbox. Chaque cadran est à l'échelle 1 et la fenêtre prend
         l'EMPREINTE du style et de l'orientation courants (LargeurCadran / HauteurCadran du VM, miroir
         d'EmpreinteCadran) : 170×170 pour Anneaux et Braises, rectangle propre pour Fusible, Marée, Volets.
         Le centre est le milieu de l'empreinte.
         Phase 42.1 (§11 B1) : fenêtre = empreinte, + bande de 14 px sous les cadrans rectangulaires pour la rangée
         de pastilles (HauteurFenetre du VM, miroir d'EmpreinteCadran.Fenetre) ; le cadran reste ancré en haut à gauche. -->
    <Window.Resources>
        <!-- Tokens de design + converters, au niveau fenêtre : la vue est autonome (les StaticResource
             résolvent sans dépendre d'une Application démarrée). Source unique : Resources/DesignTokens.xaml. -->
        <ResourceDictionary Source="pack://application:,,,/Chronos;component/Resources/DesignTokens.xaml"/>
    </Window.Resources>
    <Grid x:Name="Racine" MouseLeftButtonDown="Racine_MouseLeftButtonDown" MouseMove="Racine_MouseMove"
          MouseLeftButtonUp="Racine_MouseLeftButtonUp" LostMouseCapture="Racine_LostMouseCapture"
          MouseRightButtonUp="OnRightClick">
        <!-- GST-01 (phase 42, R7) : UN SEUL répartiteur de gestes, sur cette grille, pour toute la silhouette du cadran.
               - clic sans bouger            = bascule pourcentage / temps (à l'échéance du délai de double-clic) ;
               - double-clic                 = Historique, sans bascule ;
               - appuyer-glisser au-delà du seuil Windows = déplacer la fenêtre, puis l'accrocher au coin le plus proche ;
               - clic droit                  = réglages, partout où il arrive (non filtré, pastilles comprises) ;
               - hors silhouette             = le clic traverse vers le bureau (pixel d'alpha 0).
             Le répartiteur est ICI parce que la silhouette est une SŒUR du contenu, pas son ancêtre : la racine est le seul
             ancêtre commun de tout ce qui est peint. PAS de Background sur cette grille : elle ne doit rien capter hors
             silhouette. -->

        <!-- ===================== STYLE « ANNEAUX » (défaut, historique) =====================
             Extrait en vue de cadran (Views/Cadrans/CadranArcsView.xaml) en phase 40, pour la galerie. -->
        <cadv:CadranArcsView x:Name="VueArcs" Visibility="{Binding IsStyleArcs, Converter={StaticResource BoolToVis}}"/>

        <!-- ===================== NOUVELLES PISTES (refonte visuelle) =====================
             Chacune réutilise FiveHour/SevenDay. Phase 40 : échelle 1, enfants directs du Grid racine ; la
             fenêtre prend l'empreinte du cadran visible. Les trois cadrans rectangulaires reçoivent
             l'orientation MÉMORISÉE PAR CADRAN du VM (OrientationFusible / Maree / Volets), sans lien avec
             la disposition du widget de sessions. -->
        <cadv:CadranBraisesView Visibility="{Binding IsStyleBraises, Converter={StaticResource BoolToVis}}"/>
        <cadv:CadranFusibleView Orientation="{Binding OrientationFusible}" Visibility="{Binding IsStyleFusible, Converter={StaticResource BoolToVis}}"/>
        <cadv:CadranMareeView Orientation="{Binding OrientationMaree}" Visibility="{Binding IsStyleMaree, Converter={StaticResource BoolToVis}}"/>
        <cadv:CadranVoletsView Orientation="{Binding OrientationVolets}" Visibility="{Binding IsStyleVolets, Converter={StaticResource BoolToVis}}"/>

        <!-- M-INDISPO (EXA-03) : « je ne sais pas ». LE MOT, et pas seulement l'absence de chiffre —
             l'absence seule est AMBIGUË avec l'état « en attente » (aucune donnée encore reçue), qui
             rend exactement le même neutre dans les quatre styles alternatifs. Sans le mot, la
             quatrième apparence de la sémiologie n'existe pas.
             Couche racine => un seul exemplaire pour 5 styles × 2 modes × tous les thèmes.
             §11 B2 (DESIGN-REVIEW 1) : CENTRÉ dans l'EMPREINTE pour les 8 variantes — le cadre a la taille du
             cadran (LargeurCadran × HauteurCadran), pas celle de la fenêtre : la bande des pastilles est exclue.
             Plus de bas-gauche : l'ancien argument « hors des anneaux » tombe, en état indisponible le centre
             d'Arcs et de Braises est vide.
             La plaque FondCadran (coins 6, marge 6 × 2) garantit ≥ 4,5:1 au TextePrincipal quel que soit le
             dessous (prouvé par ThemingTests.La_plaque_indisponible_garantit_le_texte_principal) : fini le gris
             sur gris de la géométrie neutre.
             IsHitTestVisible=False : le mot ne capte rien ; la silhouette dessous reçoit le geste, la bascule
             fonctionne même sans chiffre. -->
        <Grid x:Name="CadreMotIndisponible"
              Width="{Binding LargeurCadran}" Height="{Binding HauteurCadran}"
              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="{Binding DataUnavailable, Converter={StaticResource BoolToVis}}">
            <Border x:Name="PlaqueIndisponible" Background="{DynamicResource FondCadran}"
                    CornerRadius="{StaticResource CadranPlaqueRayon}" Padding="{StaticResource CadranPlaqueMarge}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="MotIndisponible" Text="indisponible"
                           FontSize="{StaticResource CadranCorpsLibelle}"
                           Foreground="{DynamicResource TextePrincipal}"/>
            </Border>
        </Grid>

        <!-- ============ RANGÉE DE PASTILLES (TOK-02 / TOK-03 / EXA-05 / EXA-03) ============
             DERNIERS enfants du Grid racine => au-dessus de TOUS les styles de cadran : uniques pour
             les 5 styles (Anneaux/Braises/Fusible/Marée/Volets) et les 2 modes, sans duplication, et
             sans toucher aux UserControl de Views/Cadrans (la galerie de cadrans reste intacte).
             C'est la SEULE couche style-agnostique du projet, et la seule en {DynamicResource} : les
             quatre UserControl de Views/Cadrans codent leurs couleurs en dur.

             RANGÉE et non superposition, et c'est la réparation d'un DÉFAUT, pas un embellissement :
             « hors ligne » et « invitation » peuvent légitimement être allumées ENSEMBLE (hors ligne
             éteint la pastille de déconnexion, ce qui libère l'invitation), et deux marges
             conventionnelles ne garantissaient rien — mesuré : la pastille grise de 10 px était
             ENTIÈREMENT contenue dans le bouton de 14 px. Dans une rangée, deux pastilles ne peuvent
             plus se recouvrir parce qu'elles ne peuvent plus occuper la même case.

             MESURE, et c'est une BORNE DURE : 4 pastilles de 14 px au plus, 4 px d'écart, 6 px de
             marge => le bord gauche de la rangée tombe à x = 96, soit 72,8 px du centre (85,85). Le
             seuil des anneaux est 71,5 px (TickRing Radius=68 + TickLength=7). QUATRE tiennent ;
             CINQ seraient la limite — ne pas en ajouter une sans remesurer.

             ORDRE, de gauche à droite : âge, hors ligne, invitation, déconnexion — les INFORMATIVES
             d'abord, les ACTIONNABLES au plus près du coin, là où le pouce va les chercher.
             Le coin BAS-droite plutôt que haut-droite : l'overlay s'ancre le plus souvent en haut à
             droite de l'écran, le bas-droite est donc le moins susceptible d'être mordu par un bord.

             OÙ, selon le cadran : Arcs / Braises : dans l'empreinte (borne dure x ≥ 96) ;
             Fusible / Marée / Volets : dans la bande réservée sous l'empreinte (§11 B1) — hors silhouette, les
             pixels vides de la bande laissent passer le clic. La rangée est alignée en bas à droite de la
             FENÊTRE ; la marge basse tombe à 0 pour les cadrans rectangulaires (hauteur max des pastilles = 14 =
             la bande). La marge passe par le style : une valeur locale battrait le déclencheur. -->
        <StackPanel x:Name="RangeePastilles" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="0,0,6,6"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstStyleOrientable}" Value="True">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- M-ÂGE (EXA-03) : au moins une des deux fenêtres porte un chiffre DATÉ.
                 INFORMATIVE et INERTE — aucune Command : ne jamais crier « répare-moi » pour un fait
                 qui n'appelle aucun geste (même règle que la pastille « hors ligne »). Une Ellipse n'a
                 aucune propriété de commande : le TYPE est le verrou, pas une convention.
                 ADDITIVE et non soustractive : elle s'ajoute À CÔTÉ du chiffre, elle ne lui retire ni
                 luminance ni netteté — un relevé encore valide est un chiffre PROUVÉ juste par la
                 doctrine, le voiler serait une régression d'honnêteté.
                 ANNEAU CREUX et non disque plein : la forme la distingue au premier coup d'œil des
                 pastilles pleines voisines, et un cadran vide dit « du temps a passé » sans un mot.
                 Fill = ZoneSilhouette (alpha 1), et NON Transparent : sur une fenêtre layered, un pixel
                 d'alpha 0 laisse passer la souris — avec Transparent, seul le trait de 2 px ouvrait l'infobulle ;
                 désormais tout le disque de 12 px la porte (EXA-06). Pastille INERTE : hors du disque d'Arcs et
                 de Braises, elle capte la souris sans geste (ni bascule ni traversée) — voulu. -->
            <Ellipse x:Name="PastilleReleveDate" Width="12" Height="12"
                     VerticalAlignment="Center" Margin="0,0,4,0" Fill="{StaticResource ZoneSilhouette}"
                     Stroke="{DynamicResource TexteSecondaire}" StrokeThickness="2"
                     ToolTip="{Binding InfobulleReleve}"
                     Visibility="{Binding AfficherReleveDate, Converter={StaticResource BoolToVis}}"/>

            <!-- HORS LIGNE : INFORMATIF, gris, NON actionnable. Ne crie jamais « reconnecte-toi » à
                 quelqu'un dont le wifi est coupé : il relancerait un login, échouerait, et perdrait
                 confiance dans le signal. TexteSecondaire est déjà le token des mentions annexes
                 (estimée, épuisé, indisponible, périmée) — aucun nouveau token nécessaire. -->
            <Ellipse x:Name="PastilleHorsLigne" Width="10" Height="10"
                     VerticalAlignment="Center" Margin="0,0,4,0"
                     Fill="{DynamicResource TexteSecondaire}"
                     ToolTip="Hors ligne — chiffres non rafraîchis"
                     Visibility="{Binding AfficherPastilleHorsLigne, Converter={StaticResource BoolToVis}}"/>

            <!-- EXA-05 : JAMAIS CONNECTÉ / JAMAIS RIEN OBTENU. ACTIONNABLE, même famille que la pastille
                 de déconnexion (Button pour que MouseLeftButtonDown soit Handled : le répartiteur de la racine
                 ne voit pas le clic). Background = ZoneSilhouette (alpha 1) : Windows ne livre le clic d'une
                 fenêtre layered qu'aux pixels d'alpha > 0 (Transparent = alpha 0, « touché » par WPF mais jamais
                 atteint).
                 Command = ReconnecterCommand et SURTOUT PAS LoginClaudeCommand, qui BASCULE sur
                 IsLoggedIn == _store.Exists : un clic supprimerait le coffre de jetons.
                 Mutuellement exclusive de PastilleDeconnexion, garanti côté ViewModel (MajPastilles) :
                 les deux portent le même geste, les afficher ensemble serait une redondance. Elle peut
                 en revanche coexister avec « hors ligne » — d'où la rangée. -->
            <Button x:Name="PastilleInvitationConnexion"
                    VerticalAlignment="Center" Margin="0,0,4,0"
                    Width="14" Height="14" Background="{StaticResource ZoneSilhouette}" BorderThickness="0" Padding="0"
                    Cursor="Hand" Focusable="False"
                    ToolTip="Aucun chiffre d'usage n'a jamais été obtenu — cliquer pour se connecter à Claude"
                    Command="{Binding ReconnecterCommand}"
                    Visibility="{Binding AfficherInvitationConnexion, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{StaticResource ZoneSilhouette}">
                            <Ellipse Fill="{DynamicResource TexteSecondaire}"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- DÉCONNECTÉ : ACTIONNABLE. Button (pas Ellipse nue) car ButtonBase marque
                 MouseLeftButtonDown comme Handled => le répartiteur de la racine ne voit pas le clic (ni
                 bascule ni glisser : le login se lance).
                 Background = ZoneSilhouette (alpha 1) : Windows ne livre le clic d'une fenêtre layered
                 qu'aux pixels d'alpha > 0 (Transparent = alpha 0, « touché » par WPF mais jamais atteint).
                 Command = ReconnecterCommand et SURTOUT PAS LoginClaudeCommand, qui BASCULE et
                 supprimerait le coffre puisque IsLoggedIn ne teste que l'existence du fichier.
                 DERNIÈRE de la rangée, donc sans écart à droite : la plus urgente au plus près du coin. -->
            <Button x:Name="PastilleDeconnexion"
                    VerticalAlignment="Center"
                    Width="14" Height="14" Background="{StaticResource ZoneSilhouette}" BorderThickness="0" Padding="0"
                    Cursor="Hand" Focusable="False"
                    ToolTip="Connexion à Claude perdue — cliquer pour se reconnecter"
                    Command="{Binding ReconnecterCommand}"
                    Visibility="{Binding AfficherPastilleDeconnexion, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{StaticResource ZoneSilhouette}">
                            <Ellipse Fill="{DynamicResource Alerte}"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
