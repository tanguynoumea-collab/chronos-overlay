<Window x:Class="Chronos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Chronos.Controls"
        xmlns:cadv="clr-namespace:Chronos.Views.Cadrans"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="Manual"
        Width="170" Height="170" WindowStartupLocation="Manual">
    <!-- Cadran complet (Pattern 6 : empilement du fond vers le premier plan).
         Aucune Storyboard/blur/shadow : AllowsTransparency force le rendu logiciel.
         Aucun code-behind : uniquement des bindings + converters. Centre = 85,85 (Grid 170×170).
         Refonte visuelle : le style est sélectionnable (Anneaux / Braises / Fusible / Marée / Volets),
         un seul groupe visible à la fois (IsStyleX). Les 4 nouvelles pistes réutilisent FiveHour/SevenDay
         et sont mises à l'échelle par un Viewbox pour tenir dans l'empreinte 170×170. -->
    <Window.Resources>
        <!-- Tokens de design + converters, au niveau fenêtre : la vue est autonome (les StaticResource
             résolvent sans dépendre d'une Application démarrée). Source unique : Resources/DesignTokens.xaml. -->
        <ResourceDictionary Source="pack://application:,,,/Chronos;component/Resources/DesignTokens.xaml"/>
    </Window.Resources>
    <Grid MouseRightButtonUp="OnRightClick">
        <!-- Clic DROIT = ouvre la fenêtre de réglages sombre (remplace l'ancien menu contextuel gris).
             Clic gauche = drag (code-behind), clic au centre = bascule %/temps (style Anneaux). -->

        <!-- ===================== STYLE « ANNEAUX » (défaut, historique) ===================== -->
        <Grid Visibility="{Binding IsStyleArcs, Converter={StaticResource BoolToVis}}">
            <!-- Fond TRANSPARENT : plus de grand disque — les anneaux flottent sur le bureau.
                 Seul un petit disque CENTRAL (dans le trou de l'anneau interne, R38) soutient les %
                 pour qu'ils restent lisibles quel que soit le fond d'écran. -->
            <Ellipse Width="64" Height="64" Fill="{DynamicResource FondCadran}"/>

            <!-- ANNEAU HEBDO (PARTAGÉ aux deux modes) : piste + valeur, interne R38. Remplissage INVERSÉ
                 (VIS-01) → FractionElapsed, se remplit à l'approche du reset. Couleur = utilization hebdo. -->
            <ctrl:RingArc Fraction="1" Radius="38"
                          Stroke="{DynamicResource PisteHebdo}" StrokeThickness="8"/>
            <ctrl:RingArc x:Name="ArcHebdo" Radius="38" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fraction="{Binding SevenDay.FractionElapsed}"
                          Stroke="{Binding SevenDay.ValueBrush}"/>

            <!-- ===== MODE ÉTENDU (3 anneaux) : 5 h (milieu, épais) + timeline 24 h (externe, fine). ===== -->
            <Grid Visibility="{Binding IsModeEtendu, Converter={StaticResource BoolToVis}}">
                <ctrl:RingArc Fraction="1" Radius="54" Stroke="{DynamicResource Piste5h}" StrokeThickness="8"/>
                <ctrl:RingArc Fraction="1" Radius="64" Stroke="{DynamicResource Piste24h}" StrokeThickness="4"/>
                <!-- Arc valeur 5 h (R54) : remplissage inversé (FractionElapsed). -->
                <ctrl:RingArc x:Name="ArcCinqHeures" Radius="54" StrokeThickness="8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fraction="{Binding FiveHour.FractionElapsed}"
                              Stroke="{Binding FiveHour.ValueBrush}"/>
                <!-- Marques horaires 5 h (Count=5, tous les 72°), bord externe de l'anneau 5 h. -->
                <ctrl:TickRing Count="5" Radius="59" TickLength="7"
                               Stroke="{DynamicResource TickVisible}" StrokeThickness="2.5"/>
                <!-- Timeline 24 h (R64, fine) : fraction du jour (JOUR-01), couleur = utilization 5 h (JOUR-03). -->
                <ctrl:RingArc x:Name="ArcVingtQuatreHeures" Radius="64" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fraction="{Binding DayFraction}"
                              Stroke="{Binding FiveHour.ValueBrush}"/>
                <!-- Ticks des resets 5 h projetés sur l'axe 24 h (JOUR-02), bord externe. Couleur DISTINCTE (cyan). -->
                <ctrl:TickRing Radius="68" TickLength="7"
                               Angles="{Binding DayResetAngles}"
                               Stroke="{DynamicResource TickReset}" StrokeThickness="2.5"/>
            </Grid>

            <!-- ===== MODE NORMAL (DÉFAUT, 2 anneaux) : la timeline 24 h portée en anneau PRINCIPAL (R56, épais),
                 couleur = utilization 5 h (l'anneau 5 h séparé disparaît → son usage passe dans la couleur).
                 + 24 SOUS-TIRETS horaires (mineurs) + marques de RESET 5 h (visibles, plus longues). ===== -->
            <Grid Visibility="{Binding IsModeNormal, Converter={StaticResource BoolToVis}}">
                <ctrl:RingArc Fraction="1" Radius="52" Stroke="{DynamicResource Piste5h}" StrokeThickness="7"/>
                <ctrl:RingArc x:Name="ArcTimelineNormal" Radius="52" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fraction="{Binding DayFraction}"
                              Stroke="{Binding FiveHour.ValueBrush}"/>
                <!-- Sous-tirets HORAIRES alignés sur la grille des resets 5 h (DaySubTickAngles) : ils subdivisent
                     chaque intervalle de 5 h entre deux marques principales (PAS un cadran 24 h fixe). Sur le trait
                     de l'anneau (bande R48,5–R55,5 : Radius=55,5, TickLength=7), gris secondaire, premier plan. -->
                <ctrl:TickRing Radius="55.5" TickLength="7"
                               Angles="{Binding DaySubTickAngles}"
                               Stroke="{DynamicResource TexteSecondaire}" StrokeThickness="1.8"/>
                <!-- Marques de reset 5 h projetées (JOUR-02) : couleur DISTINCTE (cyan TickReset) pour se démarquer
                     des sous-tirets horaires gris. Sur le trait, légèrement débordantes (R48–R57), épaisses, premier plan. -->
                <ctrl:TickRing Radius="57" TickLength="9"
                               Angles="{Binding DayResetAngles}"
                               Stroke="{DynamicResource TickReset}" StrokeThickness="3.2"/>
            </Grid>

            <!-- Bloc central : deux modes alternés par un clic au centre (ToggleCenterMode).
                 Mode POURCENTAGES (défaut) : UtilizationText (« ~ » si estimé, vide si inconnu).
                 Mode TEMPS : CountdownText (temps avant reset). 5 h en gros/blanc, hebdo plus petit/clair. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FiveHour.UtilizationText}"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextePrincipal}"/>
                <TextBlock Text="{Binding SevenDay.UtilizationText}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,1,0,0"
                           Foreground="{DynamicResource TexteSecondaireClair}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FiveHour.CountdownText}"
                           FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextePrincipal}"/>
                <TextBlock Text="{Binding SevenDay.CountdownText}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,1,0,0"
                           Foreground="{DynamicResource TexteSecondaireClair}"/>
            </StackPanel>
        </Grid>

        <!-- ===================== NOUVELLES PISTES (refonte visuelle) =====================
             Chacune réutilise FiveHour/SevenDay et est mise à l'échelle par un Viewbox pour tenir dans
             l'empreinte 170×170 sans changer la taille de la fenêtre (ancrage/placement préservés). -->
        <Viewbox Stretch="Uniform" Margin="4"
                 Visibility="{Binding IsStyleBraises, Converter={StaticResource BoolToVis}}">
            <cadv:CadranBraisesView/>
        </Viewbox>
        <Viewbox Stretch="Uniform" Margin="6"
                 Visibility="{Binding IsStyleFusible, Converter={StaticResource BoolToVis}}">
            <cadv:CadranFusibleView/>
        </Viewbox>
        <Viewbox Stretch="Uniform" Margin="6"
                 Visibility="{Binding IsStyleMaree, Converter={StaticResource BoolToVis}}">
            <cadv:CadranMareeView/>
        </Viewbox>
        <Viewbox Stretch="Uniform" Margin="6"
                 Visibility="{Binding IsStyleVolets, Converter={StaticResource BoolToVis}}">
            <cadv:CadranVoletsView/>
        </Viewbox>

        <!-- Zone de CLIC au centre PARTAGÉE par tous les styles (transparente, au-dessus de tout) :
             bascule %/temps. MouseLeftButtonDown marqué Handled (code-behind) → n'entraîne PAS le DragMove
             (le drag reste possible en saisissant l'overlay hors du centre). -->
        <Ellipse x:Name="CentreHit" Width="66" Height="66" Fill="Transparent" Cursor="Hand"
                 ToolTip="Cliquer : basculer pourcentage / temps avant reset"
                 MouseLeftButtonDown="CentreHit_MouseLeftButtonDown"/>

        <!-- ============ PASTILLES D'AUTHENTIFICATION (TOK-02 / TOK-03) ============
             DERNIERS enfants du Grid racine => au-dessus de TOUS les styles de cadran : uniques pour
             les 5 styles (Anneaux/Braises/Fusible/Marée/Volets) et les 2 modes, sans duplication, et
             sans toucher aux UserControl de Views/Cadrans (la galerie de cadrans reste intacte).
             Géométrie : l'anneau le plus externe culmine vers (136,136) dans la boîte 170x170 ; une
             pastille de 14 px ancrée bas-droite occupe ≈ (150..164) — franchement à l'écart.
             Le coin BAS-droite plutôt que haut-droite : l'overlay s'ancre le plus souvent en haut à
             droite de l'écran, le bas-droite est donc le moins susceptible d'être mordu par un bord. -->

        <!-- DÉCONNECTÉ : ACTIONNABLE. Button (pas Ellipse nue) car ButtonBase marque
             MouseLeftButtonDown comme Handled => aucun DragMove parasite (le handler de fenêtre
             bloquerait jusqu'au relâchement au lieu de lancer le login).
             Background non-null => hit-testable sur fenêtre AllowsTransparency (Transparent suffit
             en WPF ; seul {x:Null} ne l'est pas — CentreHit le prouve en production).
             Command = ReconnecterCommand et SURTOUT PAS LoginClaudeCommand, qui BASCULE et
             supprimerait le coffre puisque IsLoggedIn ne teste que l'existence du fichier. -->
        <Button x:Name="PastilleDeconnexion"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                Width="14" Height="14" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Focusable="False"
                ToolTip="Connexion à Claude perdue — cliquer pour se reconnecter"
                Command="{Binding ReconnecterCommand}"
                Visibility="{Binding AfficherPastilleDeconnexion, Converter={StaticResource BoolToVis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse Fill="{DynamicResource Alerte}"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- HORS LIGNE : INFORMATIF, gris, NON actionnable. Ne crie jamais « reconnecte-toi » à
             quelqu'un dont le wifi est coupé : il relancerait un login, échouerait, et perdrait
             confiance dans le signal. TexteSecondaire est déjà le token des mentions annexes
             (estimée, épuisé, indisponible, périmée) — aucun nouveau token nécessaire. -->
        <Ellipse x:Name="PastilleHorsLigne"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                 Width="10" Height="10" Fill="{DynamicResource TexteSecondaire}"
                 ToolTip="Hors ligne — chiffres non rafraîchis"
                 Visibility="{Binding AfficherPastilleHorsLigne, Converter={StaticResource BoolToVis}}"/>

        <!-- EXA-05 : JAMAIS CONNECTÉ / JAMAIS RIEN OBTENU. ACTIONNABLE, même famille que la pastille
             de déconnexion (Button pour que MouseLeftButtonDown soit Handled, donc aucun DragMove
             parasite ; Background non-null pour rester hit-testable sur une fenêtre AllowsTransparency
             — Transparent suffit en WPF, seul {x:Null} ne l'est pas).
             Command = ReconnecterCommand et SURTOUT PAS LoginClaudeCommand, qui BASCULE sur
             IsLoggedIn == _store.Exists : un clic supprimerait le coffre de jetons.
             Mutuellement exclusive de PastilleDeconnexion, garanti côté ViewModel (MajPastilles) :
             les deux portent le même geste, les afficher ensemble serait une redondance.
             Son apparence définitive (tokens de design, cohabitation des trois pastilles dans les deux
             modes et les trois thèmes) est la phase 20 ; ici on livre le SIGNAL, pas sa forme finale. -->
        <Button x:Name="PastilleInvitationConnexion"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                Width="14" Height="14" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Focusable="False"
                ToolTip="Aucun chiffre d'usage n'a jamais été obtenu — cliquer pour se connecter à Claude"
                Command="{Binding ReconnecterCommand}"
                Visibility="{Binding AfficherInvitationConnexion, Converter={StaticResource BoolToVis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse Fill="{DynamicResource TexteSecondaire}"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
