<UserControl x:Class="Chronos.Views.Cadrans.CadranArcsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Chronos.Controls"
             Background="Transparent">
    <!-- Style « Anneaux » (défaut, historique). Extrait MOT POUR MOT de MainWindow.xaml en phase 40 pour que la galerie
         des cadrans puisse le montrer à côté des autres variantes. Empreinte 170 × 170 (tokens CadranLargeurArcs /
         CadranHauteurArcs), centre 85,85. Couleurs : uniquement DynamicResource du thème ou liaisons. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Width="{DynamicResource CadranLargeurArcs}" Height="{DynamicResource CadranHauteurArcs}">
        <!-- Fond TRANSPARENT : plus de grand disque — les anneaux flottent sur le bureau.
             Seul un petit disque CENTRAL (dans le trou de l'anneau interne, R38) soutient les %
             pour qu'ils restent lisibles quel que soit le fond d'écran. -->
        <Ellipse Width="64" Height="64" Fill="{DynamicResource FondCadran}"/>

        <!-- ANNEAU HEBDO (PARTAGÉ aux deux modes) : piste + valeur, interne R38. Remplissage INVERSÉ
             (VIS-01) → FractionElapsed, se remplit à l'approche du reset. Couleur = utilization hebdo. -->
        <ctrl:RingArc Fraction="1" Radius="38"
                      Stroke="{DynamicResource PisteHebdo}" StrokeThickness="8"/>
        <!-- M-PLANCHER (EXA-03) — LA TEXTURE, troisième canal de Bertin, libre par construction :
             la géométrie dit le TEMPS, la luminance dit le QUOTA, le grain dit « borne inférieure ».
             La loi d'encodage du projet est donc respectée sans détourner aucun de ses deux canaux.
             Les quatre styles alternatifs (braises, fusible, marée, volets) portaient DÉJÀ ce canal ;
             les Anneaux étaient le seul style aveugle au plancher.
             Le pointillé dit « au moins », JAMAIS « vieux » : un chiffre daté mais VÉRIFIÉ
             (EncoreValide) reste un trait PLEIN — la doctrine est allée prouver qu'il est juste, et
             le démotiser serait une régression d'honnêteté. L'âge se dit ailleurs, par une pastille
             ADDITIVE qui ne retire ni luminance ni netteté au chiffre.
             UNITÉS : multiples de l'épaisseur du trait, PAS des pixels. À 8 px d'épaisseur,
             « 0.55 0.45 » donne des tirets de 4,4 px espacés de 3,6 px — comparable au grain des
             braises (tirets 1,4 / 1,4 sur un trait de 1,4). Une valeur en pixels (« 4 3 ») produirait
             des tirets de 32 px : l'anneau paraîtrait cassé.
             De la GÉOMÉTRIE pure : aucun effet, aucune animation, donc gratuit sous le rendu
             logiciel qu'impose AllowsTransparency. -->
        <ctrl:RingArc x:Name="ArcHebdo" Radius="38" StrokeThickness="8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fraction="{Binding SevenDay.FractionElapsed}"
                      Stroke="{Binding SevenDay.ValueBrush}">
            <ctrl:RingArc.Style>
                <Style TargetType="ctrl:RingArc">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SevenDay.EstPlancher}" Value="True">
                            <Setter Property="StrokeDashArray" Value="0.55 0.45"/>
                            <Setter Property="StrokeDashCap" Value="Round"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ctrl:RingArc.Style>
        </ctrl:RingArc>

        <!-- ===== MODE ÉTENDU (3 anneaux) : 5 h (milieu, épais) + timeline 24 h (externe, fine). ===== -->
        <Grid Visibility="{Binding IsModeEtendu, Converter={StaticResource BoolToVis}}">
            <ctrl:RingArc Fraction="1" Radius="54" Stroke="{DynamicResource Piste5h}" StrokeThickness="8"/>
            <ctrl:RingArc Fraction="1" Radius="64" Stroke="{DynamicResource Piste24h}" StrokeThickness="4"/>
            <!-- Arc valeur 5 h (R54) : remplissage inversé (FractionElapsed). -->
            <ctrl:RingArc x:Name="ArcCinqHeures" Radius="54" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fraction="{Binding FiveHour.FractionElapsed}"
                          Stroke="{Binding FiveHour.ValueBrush}">
                <!-- M-PLANCHER de la fenêtre 5 h (voir la doctrine au-dessus de l'arc hebdo). -->
                <ctrl:RingArc.Style>
                    <Style TargetType="ctrl:RingArc">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FiveHour.EstPlancher}" Value="True">
                                <Setter Property="StrokeDashArray" Value="0.55 0.45"/>
                                <Setter Property="StrokeDashCap" Value="Round"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctrl:RingArc.Style>
            </ctrl:RingArc>
            <!-- Marques horaires 5 h (Count=5, tous les 72°), bord externe de l'anneau 5 h. -->
            <ctrl:TickRing Count="5" Radius="59" TickLength="7"
                           Stroke="{DynamicResource TickVisible}" StrokeThickness="2.5"/>
            <!-- Timeline 24 h (R64, fine) : fraction du jour (JOUR-01), couleur = utilization 5 h (JOUR-03).
                 DÉLIBÉRÉMENT NON MARQUÉE et ce n'est pas un oubli : en mode Étendu la fenêtre 5 h a déjà
                 son arc ÉPAIS marqué juste en dessous (R54, 8 px). Répéter la marque sur un anneau de
                 4 px produirait des tirets de 2,2 px — illisibles — et une redondance bruyante. Décision
                 verrouillée par une assertion (Le_plancher_5h_marque_l_anneau_du_mode_ETENDU), pas par
                 ce seul commentaire. -->
            <ctrl:RingArc x:Name="ArcVingtQuatreHeures" Radius="64" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fraction="{Binding DayFraction}"
                          Stroke="{Binding FiveHour.ValueBrush}"/>
            <!-- Ticks des resets 5 h projetés sur l'axe 24 h (JOUR-02), bord externe. Couleur DISTINCTE (cyan). -->
            <ctrl:TickRing Radius="68" TickLength="7"
                           Angles="{Binding DayResetAngles}"
                           Stroke="{DynamicResource TickReset}" StrokeThickness="2.5"/>
        </Grid>

        <!-- ===== MODE NORMAL (DÉFAUT, 2 anneaux) : la timeline 24 h portée en anneau PRINCIPAL (R56, épais),
             couleur = utilization 5 h (l'anneau 5 h séparé disparaît → son usage passe dans la couleur).
             + 24 SOUS-TIRETS horaires (mineurs) + marques de RESET 5 h (visibles, plus longues). ===== -->
        <Grid Visibility="{Binding IsModeNormal, Converter={StaticResource BoolToVis}}">
            <ctrl:RingArc Fraction="1" Radius="52" Stroke="{DynamicResource Piste5h}" StrokeThickness="7"/>
            <ctrl:RingArc x:Name="ArcTimelineNormal" Radius="52" StrokeThickness="7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fraction="{Binding DayFraction}"
                          Stroke="{Binding FiveHour.ValueBrush}">
                <!-- M-PLANCHER de la fenêtre 5 h en mode NORMAL (le mode par DÉFAUT). Sa GÉOMÉTRIE est
                     celle du jour, mais sa COULEUR est celle de l'usage 5 h : il n'existe aucun anneau
                     5 h dédié dans ce mode, l'usage 5 h passe entièrement par cet anneau-ci. C'est donc
                     lui — et lui seul — qui doit porter la marque du plancher 5 h ; sans cela le mode
                     par défaut serait le seul des deux à ne rien dire. -->
                <ctrl:RingArc.Style>
                    <Style TargetType="ctrl:RingArc">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FiveHour.EstPlancher}" Value="True">
                                <Setter Property="StrokeDashArray" Value="0.55 0.45"/>
                                <Setter Property="StrokeDashCap" Value="Round"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctrl:RingArc.Style>
            </ctrl:RingArc>
            <!-- Sous-tirets HORAIRES alignés sur la grille des resets 5 h (DaySubTickAngles) : ils subdivisent
                 chaque intervalle de 5 h entre deux marques principales (PAS un cadran 24 h fixe). Sur le trait
                 de l'anneau (bande R48,5–R55,5 : Radius=55,5, TickLength=7), gris secondaire, premier plan. -->
            <ctrl:TickRing Radius="55.5" TickLength="7"
                           Angles="{Binding DaySubTickAngles}"
                           Stroke="{DynamicResource TexteSecondaire}" StrokeThickness="1.8"/>
            <!-- Marques de reset 5 h projetées (JOUR-02) : couleur DISTINCTE, TickReset (texte principal du thème), pour se démarquer
                 des sous-tirets horaires gris. Sur le trait, légèrement débordantes (R48–R57), épaisses, premier plan. -->
            <ctrl:TickRing Radius="57" TickLength="9"
                           Angles="{Binding DayResetAngles}"
                           Stroke="{DynamicResource TickReset}" StrokeThickness="3.2"/>
        </Grid>

        <!-- Bloc central : deux modes alternés par un clic au centre (ToggleCenterMode).
             Mode POURCENTAGES (défaut) : UtilizationText (« ~ » si estimé, vide si inconnu).
             Mode TEMPS : CountdownText (temps avant reset). 5 h en gros/blanc, hebdo plus petit/clair. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FiveHour.UtilizationText}"
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextePrincipal}"/>
            <TextBlock Text="{Binding SevenDay.UtilizationText}"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,1,0,0"
                       Foreground="{DynamicResource TexteSecondaireClair}"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FiveHour.CountdownText}"
                       FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextePrincipal}"/>
            <TextBlock Text="{Binding SevenDay.CountdownText}"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,1,0,0"
                       Foreground="{DynamicResource TexteSecondaireClair}"/>
        </StackPanel>
    </Grid>
</UserControl>
