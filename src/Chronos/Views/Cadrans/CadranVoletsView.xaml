<UserControl x:Class="Chronos.Views.Cadrans.CadranVoletsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cad="clr-namespace:Chronos.Controls"
             Background="Transparent">
    <!-- Piste 4 — Afficheur à volets (Solari). Chiffre EXACT du compte à rebours = temps (le plus
         honnête) ; luminance de la plaque = quota ; volets = repère périphérique ; plaque tramée = estimé. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel Width="234" VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Ligne 5 H -->
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" Background="{DynamicResource CadranTuile}" CornerRadius="5">
                <TextBlock Text="5H" Foreground="{DynamicResource TexteSecondaire}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="1" Height="30" Margin="8,0" CornerRadius="5"
                    Background="{Binding FiveHour.ValueBrush}">
                <Grid>
                    <Rectangle Fill="{DynamicResource PlaqueHachure}" RadiusX="5" RadiusY="5"
                               Visibility="{Binding FiveHour.EstPlancher, Converter={StaticResource BoolToVis}}"/>
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource PlaqueFilet}"/>
                    <TextBlock Text="{Binding FiveHour.CountdownText}" Foreground="{DynamicResource PlaqueTexte}"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding FiveHour.UtilizationText}" Foreground="{DynamicResource PlaqueTexte}"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <cad:FlapRow Grid.Column="2" Width="84" Height="16" Count="6" VerticalAlignment="Center"
                         Fraction="{Binding FiveHour.FractionRemaining}"
                         HasData="{Binding FiveHour.HasTime}"
                         OnBrush="{DynamicResource TextePrincipal}" OffBrush="{DynamicResource Piste5h}" WaitBrush="{DynamicResource CadranAttente}"/>
        </Grid>

        <!-- Ligne 7 J -->
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" Background="{DynamicResource CadranTuile}" CornerRadius="5">
                <TextBlock Text="7J" Foreground="{DynamicResource TexteSecondaire}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="1" Height="30" Margin="8,0" CornerRadius="5"
                    Background="{Binding SevenDay.ValueBrush}">
                <Grid>
                    <Rectangle Fill="{DynamicResource PlaqueHachure}" RadiusX="5" RadiusY="5"
                               Visibility="{Binding SevenDay.EstPlancher, Converter={StaticResource BoolToVis}}"/>
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource PlaqueFilet}"/>
                    <TextBlock Text="{Binding SevenDay.CountdownText}" Foreground="{DynamicResource PlaqueTexte}"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding SevenDay.UtilizationText}" Foreground="{DynamicResource PlaqueTexte}"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <cad:FlapRow Grid.Column="2" Width="84" Height="16" Count="6" VerticalAlignment="Center"
                         Fraction="{Binding SevenDay.FractionRemaining}"
                         HasData="{Binding SevenDay.HasTime}"
                         OnBrush="{DynamicResource TextePrincipal}" OffBrush="{DynamicResource Piste5h}" WaitBrush="{DynamicResource CadranAttente}"/>
        </Grid>
    </StackPanel>
</UserControl>
