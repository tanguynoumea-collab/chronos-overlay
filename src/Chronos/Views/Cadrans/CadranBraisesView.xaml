<UserControl x:Class="Chronos.Views.Cadrans.CadranBraisesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cad="clr-namespace:Chronos.Controls"
             xmlns:vues="clr-namespace:Chronos.Views">
    <!-- Piste 1 — Anneau de braises. Deux couronnes discrètes : journée (externe) + hebdo (interne).
         Externe = la JOURNÉE locale (constat du 2026-10-05, plan 43-09) : 24 braises, une par heure, minuit en haut, sens
         horaire (repère de DayTimeline). Groupées par tranches de la grille des resets 5 h, ancrée sur le resets_at 5 h
         COURANT (serveur) ; les autres limites sont PROJETÉES de 5 h en 5 h. Le vide entre deux tranches est la seule
         délimitation (braises rapprochées du centre de leur groupe par 0,8 : 12° entre braises, ≤ 6° de leur heure).
         Heures passées allumées, heure en cours en demi-lueur, futur en cendre ; couleur = quota 5 h, estimé = pointillé.
         Angles et états calculés par BraisesJournee dans le VM (tick 1 s, fuseau injecté) ; reset inconnu → 24 braises
         uniformes, aucune tranche inventée. L'anneau journée n'a pas d'état « en attente » : l'heure locale est toujours connue.
         Hebdo = 14 braises en 7 groupes d'un jour, une braise par demi-journée (pas de 15,6° ≈ 12 px à R44 ; le vide
         entre groupes délimite les jours — constat du 2026-10-04).
         Hebdo : rempli = temps consommé (FractionElapsed, plan 43-06) : les braises s'allument depuis midi, sens horaire ;
         l'anneau est plein au reset. Pas de flèche de reset (retirée au constat du 2026-10-04, plan 43-07 : décision
         utilisateur, « elle ne sert à rien »). Couleur = quota ; estimé = braises en pointillé.
         Centre : bascule % (défaut, 2 lignes) ↔ temps (3 lignes : compte à rebours 5 h, hebdo, puis « ↻ HH:MM » du
         reset 5 h) — ShowPercent/ShowCountdown, clic sur le cadran.
         Braises éteintes = piste (Piste5h), plus sombres : le gris épuisé s'en détache — §11 B3. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Width="{DynamicResource CadranLargeurBraises}" Height="{DynamicResource CadranHauteurBraises}">
        <!-- Silhouette de geste (R7) : TOUTE la forme capte la souris. ZoneSilhouette (alpha 1) et non Transparent : sur une fenêtre layered, Windows laisse passer le clic là où l'alpha vaut 0. -->
        <Ellipse Width="148" Height="148" vues:ZoneGeste.Silhouette="True" Fill="{DynamicResource ZoneSilhouette}"/>
        <cad:EmberRingControl Radius="66" Count="24" PipRadius="4.0"
                              Angles="{Binding JourneeAngles}"
                              Etats="{Binding JourneeEtats}"
                              QuotaBrush="{Binding FiveHour.ValueBrush}"
                              Estimated="{Binding FiveHour.EstPlancher}"
                              AshBrush="{DynamicResource Piste5h}" WaitBrush="{DynamicResource CadranAttente}"/>
        <cad:EmberRingControl Radius="44" Count="14" PipRadius="3.6" GroupSize="2" GroupPitch="15.6"
                              Fraction="{Binding SevenDay.FractionElapsed}"
                              QuotaBrush="{Binding SevenDay.ValueBrush}"
                              Estimated="{Binding SevenDay.EstPlancher}"
                              HasData="{Binding SevenDay.HasTime}"
                              AshBrush="{DynamicResource Piste5h}" WaitBrush="{DynamicResource CadranAttente}"/>
        <!-- Centre en mode POURCENTAGES (défaut) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FiveHour.UtilizationText}" HorizontalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextePrincipal}"/>
            <TextBlock Text="{Binding SevenDay.UtilizationText}" HorizontalAlignment="Center"
                       FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TexteSecondaireClair}"/>
        </StackPanel>
        <!-- Centre en mode TEMPS avant reset -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FiveHour.CountdownText}" HorizontalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextePrincipal}"/>
            <TextBlock Text="{Binding SevenDay.CountdownText}" HorizontalAlignment="Center"
                       FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource TexteSecondaireClair}"/>
            <!-- BRA-02 : heure LOCALE du reset 5 h, issue de resets_at (serveur, exacte) ; absente si inconnue ou
                 atteinte — exact ou rien. BRA-02 / §11 B4 : même pinceau que la ligne hebdo, corps 11 par token. -->
            <TextBlock x:Name="HeureResetBraises" Text="{Binding FiveHour.HeureResetTexte}" HorizontalAlignment="Center"
                       FontSize="{DynamicResource CadranCorpsLibelle}" Margin="0,2,0,0" Foreground="{DynamicResource TexteSecondaireClair}"
                       Visibility="{Binding FiveHour.HasHeureReset, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
