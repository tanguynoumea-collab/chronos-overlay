<UserControl x:Class="Chronos.Views.Cadrans.CadranBraisesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cad="clr-namespace:Chronos.Controls"
             Background="Transparent">
    <!-- Piste 1 — Anneau de braises. Deux couronnes discrètes : 5 h (externe) + hebdo (interne).
         5 h = 20 braises de 15 min en 5 groupes d'une heure (le vide entre groupes délimite les heures) ;
         flèche de reset fixe à midi, là où la fenêtre se termine. Hebdo = 12 braises uniformes.
         Nombre de braises = temps restant ; couleur = quota ; estimé = braises en pointillé.
         Centre : bascule % (défaut, 2 lignes) ↔ temps (3 lignes : compte à rebours 5 h, hebdo, puis « ↻ HH:MM » du
         reset 5 h) — ShowPercent/ShowCountdown, clic au centre. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Width="{DynamicResource CadranLargeurBraises}" Height="{DynamicResource CadranHauteurBraises}">
        <cad:EmberRingControl Radius="66" Count="20" PipRadius="4.0" GroupSize="4" GroupPitch="13.2"
                              Fraction="{Binding FiveHour.FractionRemaining}"
                              QuotaBrush="{Binding FiveHour.ValueBrush}"
                              Estimated="{Binding FiveHour.EstPlancher}"
                              HasData="{Binding FiveHour.HasTime}"
                              AshBrush="{DynamicResource TickMajeur}" WaitBrush="{DynamicResource CadranAttente}"/>
        <cad:EmberRingControl Radius="44" Count="12" PipRadius="3.6"
                              Fraction="{Binding SevenDay.FractionRemaining}"
                              QuotaBrush="{Binding SevenDay.ValueBrush}"
                              Estimated="{Binding SevenDay.EstPlancher}"
                              HasData="{Binding SevenDay.HasTime}"
                              AshBrush="{DynamicResource TickMajeur}" WaitBrush="{DynamicResource CadranAttente}"/>
        <!-- Flèche de reset : ligne d'arrivée du reset 5 h, fixe à midi, hors anneau (triangle 10 × 7 + filet 12 px).
             Structure, pas donnée : visible dans tous les états. Aucune animation : le mouvement est réservé aux sessions.
             Non cliquable : la phase 42 décide des zones de geste. -->
        <Canvas x:Name="FlecheReset" Width="170" Height="170" IsHitTestVisible="False">
            <Polygon Points="80,5 90,5 85,12" Fill="{DynamicResource TickReset}"/>
            <Line X1="85" Y1="13" X2="85" Y2="25" StrokeThickness="1.2" Opacity="0.55"
                  Stroke="{DynamicResource TickReset}"/>
        </Canvas>
        <!-- Centre en mode POURCENTAGES (défaut) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FiveHour.UtilizationText}" HorizontalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextePrincipal}"/>
            <TextBlock Text="{Binding SevenDay.UtilizationText}" HorizontalAlignment="Center"
                       FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TexteSecondaireClair}"/>
        </StackPanel>
        <!-- Centre en mode TEMPS avant reset -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding FiveHour.CountdownText}" HorizontalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextePrincipal}"/>
            <TextBlock Text="{Binding SevenDay.CountdownText}" HorizontalAlignment="Center"
                       FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource TexteSecondaireClair}"/>
            <!-- BRA-02 : heure LOCALE du reset 5 h, issue de resets_at (serveur, exacte) ; absente si inconnue ou
                 atteinte — exact ou rien. Corps 10,5 littéral comme les corps voisins : aucun token de cadran à 10,5. -->
            <TextBlock x:Name="HeureResetBraises" Text="{Binding FiveHour.HeureResetTexte}" HorizontalAlignment="Center"
                       FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource TexteSecondaire}"
                       Visibility="{Binding FiveHour.HasHeureReset, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
