<UserControl x:Class="Chronos.Views.Cadrans.CadranMareeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cad="clr-namespace:Chronos.Controls"
             Background="Transparent">
    <!-- Marée, à l'échelle 1 (phase 40) — part de lumière = temps restant (l'ombre gagne vers le reset) ;
         luminance = quota ; ligne d'eau nette (exact) vs pointillée (estimé).
         Deux gabarits choisis par la DP Orientation de la vue (code-behind) :
         - vertical 132 × 160 : deux colonnes, la lumière part du haut, ligne d'eau droite ;
         - horizontal 190 × 96 : deux bandes, la lumière part de la gauche, ligne d'eau ondulée.
         Valeur par fenêtre : bascule % (défaut) ↔ temps (clic au centre).
         Positions = maquette .zeus/maquettes/cycle2-cadrans-themes.html (mareeV / mareeH). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <!-- ===== Vertical : 132 × 160 — colonnes x 14..56 et x 76..118 ===== -->
        <Grid x:Name="GabaritVertical"
              Width="{DynamicResource CadranLargeurMareeV}" Height="{DynamicResource CadranHauteurMareeV}"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- 5 H -->
            <cad:TideColumn Orientation="Vertical" Width="42" Height="118" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,3,0,0"
                            Fraction="{Binding FiveHour.FractionRemaining}"
                            QuotaBrush="{Binding FiveHour.ValueBrush}"
                            Estimated="{Binding FiveHour.EstPlancher}"
                            HasData="{Binding FiveHour.HasTime}"
                            TrackBrush="{DynamicResource FondCadran}" WaterlineBrush="{DynamicResource TextePrincipal}" WaitBrush="{DynamicResource CadranAttente}"/>
            <TextBlock Text="5 H" Foreground="{DynamicResource TexteSecondaire}" FontSize="{DynamicResource CadranCorpsLibelle}" FontWeight="SemiBold"
                       Width="42" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,125,0,0"/>
            <!-- Boîte de 60 centrée sur la colonne : « ≥ 100 % » (≈ 43) dépasse la colonne de 42, pas l'empreinte. -->
            <Grid Width="60" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,140,0,0">
                <TextBlock Text="{Binding FiveHour.UtilizationText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Center" Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding FiveHour.CountdownText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Center" Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <!-- 7 J -->
            <cad:TideColumn Orientation="Vertical" Width="42" Height="118" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="76,3,0,0"
                            Fraction="{Binding SevenDay.FractionRemaining}"
                            QuotaBrush="{Binding SevenDay.ValueBrush}"
                            Estimated="{Binding SevenDay.EstPlancher}"
                            HasData="{Binding SevenDay.HasTime}"
                            TrackBrush="{DynamicResource FondCadran}" WaterlineBrush="{DynamicResource TextePrincipal}" WaitBrush="{DynamicResource CadranAttente}"/>
            <TextBlock Text="7 J" Foreground="{DynamicResource TexteSecondaire}" FontSize="{DynamicResource CadranCorpsLibelle}" FontWeight="SemiBold"
                       Width="42" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="76,125,0,0"/>
            <Grid Width="60" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="67,140,0,0">
                <TextBlock Text="{Binding SevenDay.UtilizationText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Center" Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding SevenDay.CountdownText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Center" Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>

        <!-- ===== Horizontal : 190 × 96 — bandes de 32 à y 10 et y 54, x 32..134 =====
             Longueur de bande RÉDUITE de 118 (maquette) à 102 : à 118, la valeur au pire cas (« ≥ 100 % ») débordait
             de ~11 px sur la bande (décision de l'orchestrateur, phase 40). Boîte de valeur : x 138..184 (46 px). -->
        <Grid x:Name="GabaritHorizontal"
              Width="{DynamicResource CadranLargeurMareeH}" Height="{DynamicResource CadranHauteurMareeH}"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- 5 H -->
            <TextBlock Text="5 H" Foreground="{DynamicResource TexteSecondaire}" FontSize="{DynamicResource CadranCorpsLibelle}" FontWeight="SemiBold"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,19,0,0"/>
            <cad:TideColumn Orientation="Horizontal" Width="102" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,10,0,0"
                            Fraction="{Binding FiveHour.FractionRemaining}"
                            QuotaBrush="{Binding FiveHour.ValueBrush}"
                            Estimated="{Binding FiveHour.EstPlancher}"
                            HasData="{Binding FiveHour.HasTime}"
                            TrackBrush="{DynamicResource FondCadran}" WaterlineBrush="{DynamicResource TextePrincipal}" WaitBrush="{DynamicResource CadranAttente}"/>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="16" Margin="138,18,6,0">
                <TextBlock Text="{Binding FiveHour.UtilizationText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Right" Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding FiveHour.CountdownText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Right" Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <!-- 7 J -->
            <TextBlock Text="7 J" Foreground="{DynamicResource TexteSecondaire}" FontSize="{DynamicResource CadranCorpsLibelle}" FontWeight="SemiBold"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,63,0,0"/>
            <cad:TideColumn Orientation="Horizontal" Width="102" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,54,0,0"
                            Fraction="{Binding SevenDay.FractionRemaining}"
                            QuotaBrush="{Binding SevenDay.ValueBrush}"
                            Estimated="{Binding SevenDay.EstPlancher}"
                            HasData="{Binding SevenDay.HasTime}"
                            TrackBrush="{DynamicResource FondCadran}" WaterlineBrush="{DynamicResource TextePrincipal}" WaitBrush="{DynamicResource CadranAttente}"/>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="16" Margin="138,62,6,0">
                <TextBlock Text="{Binding SevenDay.UtilizationText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Right" Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding SevenDay.CountdownText}" Foreground="{DynamicResource TextePrincipal}" FontSize="{DynamicResource CadranCorpsValeur}" FontWeight="SemiBold"
                           TextAlignment="Right" Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
