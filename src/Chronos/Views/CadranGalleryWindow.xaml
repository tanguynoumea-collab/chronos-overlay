<Window x:Class="Chronos.Views.CadranGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cadv="clr-namespace:Chronos.Views.Cadrans"
        Title="Chronos — galerie des cadrans (prototype)"
        Width="1240" Height="900" WindowStartupLocation="CenterScreen"
        Background="#0D0C12" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
        <!-- Tailles et corps des cadrans (Cadran*Largeur/Hauteur, CadranCorps*) résolus par l'hôte, sans Application démarrée ;
             les pinceaux du thème sont recopiés par-dessus par le code-behind (BrushTokens). -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Chronos;component/Resources/DesignTokens.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="Foreground" Value="#A9A8B2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Tile">
            <Setter Property="Foreground" Value="#F4F2EC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TileSub">
            <Setter Property="Foreground" Value="#75727F"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Cadrans — 8 variantes" Foreground="#F4F2EC" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="données d'échantillon pilotables" Style="{StaticResource TileSub}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="Thème" Style="{StaticResource Lbl}" Margin="28,0,8,0"/>
            <ComboBox Width="140" VerticalAlignment="Center"
                      ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      DisplayMemberPath="Name"/>
            <CheckBox Content="Afficher le temps (sinon %)" IsChecked="{Binding ShowCountdown, Mode=TwoWay}"
                      Foreground="#A9A8B2" VerticalAlignment="Center" Margin="24,0,0,0"/>
        </StackPanel>

        <!-- Curseurs de scénario -->
        <Border Grid.Row="1" Background="#15131D" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 5 h -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fenêtre 5 h" Foreground="#E9A23C" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Temps restant" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FiveTimePct, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding FiveTimePct, StringFormat={}{0:0} %}" Style="{StaticResource Lbl}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Quota consommé" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FiveQuotaPct, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding FiveQuotaPct, StringFormat={}{0:0} %}" Style="{StaticResource Lbl}" HorizontalAlignment="Right"/>
                    </Grid>
                    <CheckBox Content="Plancher (≥, relevé vieilli → grain)" IsChecked="{Binding FivePlancher, Mode=TwoWay}"
                              Foreground="#A9A8B2" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 7 j -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fenêtre hebdomadaire" Foreground="#E9A23C" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Temps restant" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SevenTimePct, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SevenTimePct, StringFormat={}{0:0} %}" Style="{StaticResource Lbl}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Quota consommé" Style="{StaticResource Lbl}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SevenQuotaPct, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SevenQuotaPct, StringFormat={}{0:0} %}" Style="{StaticResource Lbl}" HorizontalAlignment="Right"/>
                    </Grid>
                    <CheckBox Content="Plancher (≥, relevé vieilli → grain)" IsChecked="{Binding SevenPlancher, Mode=TwoWay}"
                              Foreground="#A9A8B2" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Les 8 variantes (DESIGN_PLAN_CYCLE2 §1.3), à l'échelle 1 : chaque vue dans le pointillé de son empreinte. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="4">
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Anneaux" Style="{StaticResource Tile}"/>
                            <TextBlock Text="170 × 170" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranArcsView x:Name="GalerieArcs"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Braises" Style="{StaticResource Tile}"/>
                            <TextBlock Text="170 × 170" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranBraisesView x:Name="GalerieBraises"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Fusible — horizontal" Style="{StaticResource Tile}"/>
                            <TextBlock Text="190 × 92" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranFusibleView x:Name="GalerieFusibleH" Orientation="Horizontal"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Fusible — vertical" Style="{StaticResource Tile}"/>
                            <TextBlock Text="110 × 190" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranFusibleView x:Name="GalerieFusibleV" Orientation="Vertical"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Marée — verticale" Style="{StaticResource Tile}"/>
                            <TextBlock Text="132 × 160" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranMareeView x:Name="GalerieMareeV" Orientation="Vertical"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Marée — horizontale" Style="{StaticResource Tile}"/>
                            <TextBlock Text="190 × 96" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranMareeView x:Name="GalerieMareeH" Orientation="Horizontal"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Volets — horizontal" Style="{StaticResource Tile}"/>
                            <TextBlock Text="190 × 66" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranVoletsView x:Name="GalerieVoletsH" Orientation="Horizontal"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Margin="6" MinHeight="260" CornerRadius="14" Background="#0A0910" BorderBrush="#2A2833" BorderThickness="1">
                    <Grid>
                        <StackPanel Margin="16,12" VerticalAlignment="Top">
                            <TextBlock Text="Volets — vertical" Style="{StaticResource Tile}"/>
                            <TextBlock Text="128 × 190" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,12">
                            <Rectangle Stroke="#2A2833" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                            <cadv:CadranVoletsView x:Name="GalerieVoletsV" Orientation="Vertical"/>
                        </Grid>
                    </Grid>
                </Border>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</Window>
